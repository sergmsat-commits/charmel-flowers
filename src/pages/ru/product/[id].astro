---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ProductDetail from '../../../components/ProductDetail.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const currentLocale = Astro.currentLocale ?? 'pl';
const pageTitle = `${product.data.title[currentLocale]} | Charmel Flowers`;
const pageDescription = product.data.description[currentLocale];
---
<Layout title={pageTitle} description={pageDescription}>
  <ProductDetail product={product} />
</Layout>