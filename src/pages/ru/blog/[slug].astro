---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import BlogPost from '../../../components/BlogPost.astro';

// Адрес = имя папки статьи (src/content/blog/<папка>/). Только статьи на языке «ru»
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'ru');
  return posts.map((post) => ({
    params: { slug: post.id.split('/')[0] },
    props: { post },
  }));
}

const { post } = Astro.props;
const title = `${post.data.title} | Charmel Flowers`;
---

<Layout title={title} description={post.data.description}>
  <BlogPost post={post} />
</Layout>
