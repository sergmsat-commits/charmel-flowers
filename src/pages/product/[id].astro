---
import Layout from '../../layouts/Layout.astro';
import ProductDetail from '../../components/ProductDetail.astro';
import { productMetaDescription } from '../../data/seo';
import { getProducts, photoUrl, absoluteUrl, type Locale } from '../../data/products';

// Страницы строятся только для видимых букетов (скрытые → страницы нет).
export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const currentLocale = (Astro.currentLocale ?? 'pl') as Locale;
const pageTitle = `${product.title[currentLocale]} | Charmel Flowers`;
const pageDescription = productMetaDescription(product, currentLocale);
const ogImage = absoluteUrl(await photoUrl(product.photos[0], 1200));
---
<Layout title={pageTitle} description={pageDescription} image={ogImage} type="product">
  <ProductDetail product={product} />
</Layout>
