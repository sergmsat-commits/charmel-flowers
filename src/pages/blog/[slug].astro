---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogPost from '../../components/BlogPost.astro';
import BlogHead from '../../components/BlogHead.astro';

// Адрес = имя папки статьи (src/content/blog/<папка>/). Только статьи на языке «pl»
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'pl');
  return posts.map((post) => ({
    params: { slug: post.id.split('/')[0] },
    props: { post },
  }));
}

const { post } = Astro.props;
const title = `${post.data.title} | Charmel Flowers`;
---

<Layout title={title} description={post.data.description} image={post.data.cover} type="article">
  <BlogHead slot="head" post={post} />
  <BlogPost post={post} />
</Layout>
