---
import { getRelativeLocaleUrl } from 'astro:i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title: customTitle, description: customDescription } = Astro.props;

const currentLocale = Astro.currentLocale ?? 'pl';
const locales = ['pl', 'ru', 'en'];

let pathWithoutLocale = Astro.url.pathname.replace(/^\/(ru|en)(?=\/|$)/, '');
if (pathWithoutLocale === '') pathWithoutLocale = '/';

const navLabels = {
  pl: { home: 'Strona główna', catalog: 'Katalog', delivery: 'Dostawa i płatność', about: 'O nas', contact: 'Kontakt' },
  ru: { home: 'Главная', catalog: 'Каталог', delivery: 'Доставка и оплата', about: 'О нас', contact: 'Контакты' },
  en: { home: 'Home', catalog: 'Catalog', delivery: 'Delivery & Payment', about: 'About', contact: 'Contact' },
};
const nav = navLabels[currentLocale] ?? navLabels.pl;

const meta = {
  pl: {
    title: 'Charmel Flowers | Kwiaciarnia Warszawa',
    description: 'Bukiety, które robią wrażenie. Kwiaciarnia w Warszawie, bukiet gotowy w dniu zamówienia.',
  },
  ru: {
    title: 'Charmel Flowers | Цветочный магазин в Варшаве',
    description: 'Цветочный магазин в Варшаве, где букет готов в день заказа.',
  },
  en: {
    title: 'Charmel Flowers | Warsaw Flower Shop',
    description: 'A Warsaw flower shop where your bouquet is ready on the day of order.',
  },
};
const m = meta[currentLocale] ?? meta.pl;
const pageTitle = customTitle ?? m.title;
const pageDescription = customDescription ?? m.description;

const footer = {
  pl: {
    heading: 'Charmel Flowers | Kwiaciarnia Warszawa',
    tagline: 'Bukiety, które robią wrażenie 🌺',
    delivery: '⚡ Bukiet gotowy w dniu zamówienia* • 🚗 Dostawa: Uber / Wolt',
    hoursTitle: 'Godziny otwarcia',
    hours: [
      { days: 'Pon\u2013Pt', time: '10:00\u201320:00' },
      { days: 'Sob', time: '10:00\u201318:00' },
      { days: 'Nie', time: '10:00\u201317:00' },
    ],
    rights: 'Wszelkie prawa zastrzeżone',
  },
  ru: {
    heading: 'Charmel Flowers | Цветочный магазин Варшава',
    tagline: 'Букеты, которые производят впечатление 🌺',
    delivery: '⚡ Букет готов в день заказа* • 🚗 Доставка: Uber / Wolt',
    hoursTitle: 'Часы работы',
    hours: [
      { days: 'Пн\u2013Пт', time: '10:00\u201320:00' },
      { days: 'Сб', time: '10:00\u201318:00' },
      { days: 'Вс', time: '10:00\u201317:00' },
    ],
    rights: 'Все права защищены',
  },
  en: {
    heading: 'Charmel Flowers | Warsaw Flower Shop',
    tagline: 'Bouquets that make an impression 🌺',
    delivery: '⚡ Bouquet ready on the day of order* • 🚗 Delivery: Uber / Wolt',
    hoursTitle: 'Opening Hours',
    hours: [
      { days: 'Mon\u2013Fri', time: '10:00\u201320:00' },
      { days: 'Sat', time: '10:00\u201318:00' },
      { days: 'Sun', time: '10:00\u201317:00' },
    ],
    rights: 'All rights reserved',
  },
};
const f = footer[currentLocale] ?? footer.pl;

const widgetLabels = {
  pl: { open: 'Skontaktuj się z nami', close: 'Zamknij', whatsapp: 'Napisz na WhatsApp', telegram: 'Napisz na Telegram', instagram: 'Instagram', call: 'Zadzwoń' },
  ru: { open: 'Связаться с нами', close: 'Закрыть', whatsapp: 'Написать в WhatsApp', telegram: 'Написать в Telegram', instagram: 'Instagram', call: 'Позвонить' },
  en: { open: 'Contact us', close: 'Close', whatsapp: 'Chat on WhatsApp', telegram: 'Chat on Telegram', instagram: 'Instagram', call: 'Call us' },
};
const w = widgetLabels[currentLocale] ?? widgetLabels.pl;

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'Florist',
  name: 'Charmel Flowers',
  image: 'https://charmelflowers.pl/images/logo-charmel.jpg',
  url: 'https://charmelflowers.pl',
  telephone: '+48514011410',
  priceRange: '100-1350 PLN',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Stryjeńskich 6/lok.UH1B',
    addressLocality: 'Warszawa',
    postalCode: '02-791',
    addressCountry: 'PL',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 52.1329367,
    longitude: 21.0575091,
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '10:00', closes: '20:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '10:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '10:00', closes: '17:00' },
  ],
};
---

<html lang={currentLocale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
  <script is:inline>document.documentElement.classList.add('js-ready');</script>
  <script src="/cart.js" defer></script>
  <script src="/favorites.js" defer></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const revealEls = document.querySelectorAll('.reveal');
      if (revealEls.length) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });

        revealEls.forEach((el) => observer.observe(el));
      }

      const menuToggle = document.getElementById('mobile-menu-toggle');
      const navDropdown = document.getElementById('nav-dropdown');
      if (menuToggle && navDropdown) {
        menuToggle.addEventListener('click', () => {
          const isOpen = navDropdown.classList.toggle('is-open');
          menuToggle.classList.toggle('is-active', isOpen);
          menuToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
      }

      const langCurrentBtn = document.getElementById('lang-current-btn');
      const langOptions = document.getElementById('lang-options');
      const langSwitcher = document.getElementById('lang-switcher');
      if (langCurrentBtn && langOptions) {
        langCurrentBtn.addEventListener('click', () => {
          const isOpen = langOptions.classList.toggle('is-open');
          langCurrentBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
        document.addEventListener('click', (e) => {
          if (langSwitcher && !langSwitcher.contains(e.target)) {
            langOptions.classList.remove('is-open');
            langCurrentBtn.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // Lightbox — общий для всего сайта, включается классом .lightbox-trigger + data-images
      const lightbox = document.getElementById('site-lightbox');
      const lightboxImg = document.getElementById('lightbox-img');
      const lightboxCounter = document.getElementById('lightbox-counter');
      const lightboxPrev = document.getElementById('lightbox-prev');
      const lightboxNext = document.getElementById('lightbox-next');
      const lightboxClose = document.getElementById('lightbox-close');

      let currentImages = [];
      let currentIndex = 0;

      function updateLightboxImage() {
        lightboxImg.src = currentImages[currentIndex];
        const multi = currentImages.length > 1;
        lightboxCounter.textContent = multi ? `${currentIndex + 1} / ${currentImages.length}` : '';
        lightboxPrev.style.display = multi ? '' : 'none';
        lightboxNext.style.display = multi ? '' : 'none';
      }

      function openLightbox(images, startIndex) {
        currentImages = images;
        currentIndex = startIndex;
        updateLightboxImage();
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
      }

      function closeLightbox() {
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
      }

      document.querySelectorAll('.lightbox-trigger').forEach((img) => {
        img.addEventListener('click', () => {
          const images = img.getAttribute('data-images').split(',');
          openLightbox(images, 0);
        });
      });

      lightboxClose.addEventListener('click', closeLightbox);
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
      lightboxPrev.addEventListener('click', () => {
        currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length;
        updateLightboxImage();
      });
      lightboxNext.addEventListener('click', () => {
        currentIndex = (currentIndex + 1) % currentImages.length;
        updateLightboxImage();
      });
      document.addEventListener('keydown', (e) => {
        if (!lightbox.classList.contains('is-open')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') lightboxPrev.click();
        if (e.key === 'ArrowRight') lightboxNext.click();
      });
    });
  </script>
</head>
<body>
  <div class="top-bar">
    <a href="tel:+48514011410" class="top-bar-phone">📞 +48 514 011 410</a>
  </div>

  <header class="site-header">
    <div class="header-inner">
      <a href={getRelativeLocaleUrl(currentLocale, '/')} class="logo-link">
        <img src="/images/logo-charmel.jpg" alt="Charmel Flowers" class="logo-img" />
        <span class="logo-text">Charmel Flowers</span>
      </a>

      <div class="nav-dropdown" id="nav-dropdown">
        <nav class="main-nav">
          <a href={getRelativeLocaleUrl(currentLocale, '/')}>{nav.home}</a>
          <a href={getRelativeLocaleUrl(currentLocale, '/catalog')}>{nav.catalog}</a>
          <a href={getRelativeLocaleUrl(currentLocale, '/delivery')}>{nav.delivery}</a>
          <a href={getRelativeLocaleUrl(currentLocale, '/about')}>{nav.about}</a>
          <a href={getRelativeLocaleUrl(currentLocale, '/contact')}>{nav.contact}</a>
        </nav>
      </div>

      <div class="header-right">
        <div class="lang-switcher" id="lang-switcher">
          <button class="lang-current" id="lang-current-btn" aria-expanded="false">
            {currentLocale.toUpperCase()} <span class="lang-arrow">▾</span>
          </button>
          <div class="lang-options" id="lang-options">
            {locales.filter((l) => l !== currentLocale).map((l) => (
              <a href={getRelativeLocaleUrl(l, pathWithoutLocale)}>{l.toUpperCase()}</a>
            ))}
          </div>
        </div>

        <a href={getRelativeLocaleUrl(currentLocale, '/favorites')} class="favorites-link" aria-label="Favorites">
          ♥ <span data-favorites-count>0</span>
        </a>
        <a href={getRelativeLocaleUrl(currentLocale, '/cart')} class="cart-link" aria-label="Cart">
          🛒 <span data-cart-count>0</span>
        </a>
        <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-col">
        <h4>{f.heading}</h4>
        <p class="footer-tagline">{f.tagline}</p>
        <p class="footer-delivery">{f.delivery}</p>
      </div>

      <div class="footer-col">
        <h4>{nav.contact}</h4>
        <p class="footer-contact">Stryjeńskich 6/lok.UH1B, 02-791 Warszawa</p>
        <a href="tel:+48514011410" class="footer-phone">+48 514 011 410</a>
        <div class="footer-social">
          <a href="https://www.instagram.com/charmelflowers/" target="_blank" rel="noopener" aria-label="Instagram">Instagram</a>
          <a href="https://wa.me/48514011410" target="_blank" rel="noopener" aria-label="WhatsApp">WhatsApp</a>
        </div>
      </div>

      <div class="footer-col">
        <h4>{f.hoursTitle}</h4>
        <div class="footer-hours">
          {f.hours.map((row) => (
            <p>{row.days}: {row.time}</p>
          ))}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 Charmel Flowers</p>
      <p class="footer-rights">{f.rights}</p>
    </div>
  </footer>

  <div class="lightbox" id="site-lightbox" aria-hidden="true">
    <button class="lightbox-close" id="lightbox-close" aria-label="Close">&times;</button>
    <button class="lightbox-prev" id="lightbox-prev" aria-label="Previous">&#8249;</button>
    <img src="" alt="" class="lightbox-img" id="lightbox-img" />
    <button class="lightbox-next" id="lightbox-next" aria-label="Next">&#8250;</button>
    <p class="lightbox-counter" id="lightbox-counter"></p>
  </div>

  <div class="contact-widget" id="contact-widget">
    <div class="cw-panel" id="cw-panel" role="group" aria-label={w.open}>
      <a href="https://wa.me/48514011410" target="_blank" rel="noopener" class="cw-item cw-whatsapp" aria-label={w.whatsapp} title={w.whatsapp}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      </a>
      <a href="https://t.me/+48514011410" target="_blank" rel="noopener" class="cw-item cw-telegram" aria-label={w.telegram} title={w.telegram}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </a>
      <a href="https://www.instagram.com/charmelflowers/" target="_blank" rel="noopener" class="cw-item cw-instagram" aria-label={w.instagram} title={w.instagram}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
      </a>
      <a href="tel:+48514011410" class="cw-item cw-call" aria-label={w.call} title={w.call}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </a>
      <button type="button" class="cw-close" id="cw-close" aria-label={w.close} title={w.close}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
      </button>
    </div>

    <button type="button" class="cw-toggle" id="cw-toggle" aria-label={w.open} aria-expanded="false" aria-controls="cw-panel">
      <span class="cw-icon is-active" data-cw-icon>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      </span>
      <span class="cw-icon" data-cw-icon>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </span>
      <span class="cw-icon" data-cw-icon>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
      </span>
      <span class="cw-icon" data-cw-icon>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </span>
    </button>
  </div>

  <script>
    const widget = document.getElementById('contact-widget');
    const toggle = document.getElementById('cw-toggle');
    const closeBtn = document.getElementById('cw-close');
    const icons = document.querySelectorAll('[data-cw-icon]');

    if (widget && toggle) {
      let iconIndex = 0;
      let timer = null;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function showIcon(i) {
        icons.forEach((el, n) => el.classList.toggle('is-active', n === i));
      }
      function startRotation() {
        if (reduceMotion || timer || icons.length < 2) return;
        timer = setInterval(() => {
          iconIndex = (iconIndex + 1) % icons.length;
          showIcon(iconIndex);
        }, 2200);
      }
      function stopRotation() {
        if (timer) { clearInterval(timer); timer = null; }
      }
      function setOpen(open) {
        widget.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) stopRotation(); else startRotation();
      }

      toggle.addEventListener('click', () => setOpen(!widget.classList.contains('is-open')));
      if (closeBtn) closeBtn.addEventListener('click', () => setOpen(false));
      document.addEventListener('click', (e) => {
        if (widget.classList.contains('is-open') && !widget.contains(e.target)) setOpen(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && widget.classList.contains('is-open')) setOpen(false);
      });

      startRotation();
    }
  </script>

  <style>
    .contact-widget {
      position: fixed;
      right: 20px;
      bottom: 20px;
      z-index: 500;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }
    .cw-toggle {
      position: relative;
      width: 58px;
      height: 58px;
      border-radius: 50%;
      border: none;
      background: var(--color-accent, #6B4423);
      color: #fff;
      cursor: pointer;
      box-shadow: 0 6px 18px rgba(46, 33, 24, 0.35);
      transition: transform 0.2s ease, opacity 0.2s ease;
      padding: 0;
    }
    .cw-toggle:hover { transform: scale(1.06); }
    .cw-toggle:focus-visible,
    .cw-close:focus-visible,
    .cw-item:focus-visible { outline: 3px solid var(--color-primary-dark, #C9B48F); outline-offset: 2px; }
    .cw-icon {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transform: scale(0.6) rotate(-30deg);
      transition: opacity 0.4s ease, transform 0.4s ease;
    }
    .cw-icon.is-active { opacity: 1; transform: scale(1) rotate(0); }
    .cw-icon svg { width: 26px; height: 26px; }

    .cw-panel {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      padding: 10px;
      border-radius: 32px;
      background: var(--color-white, #fff);
      box-shadow: 0 8px 24px rgba(46, 33, 24, 0.28);
      opacity: 0;
      visibility: hidden;
      transform: translateY(12px) scale(0.95);
      transform-origin: bottom center;
      transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
    }
    .contact-widget.is-open .cw-panel {
      opacity: 1;
      visibility: visible;
      transform: translateY(0) scale(1);
    }
    .contact-widget.is-open .cw-toggle {
      opacity: 0;
      visibility: hidden;
      position: absolute;
      pointer-events: none;
    }
    .cw-item,
    .cw-close {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      border: none;
      padding: 0;
      cursor: pointer;
      text-decoration: none;
      transition: transform 0.2s ease;
    }
    .cw-item:hover,
    .cw-close:hover { transform: scale(1.08); }
    .cw-item svg,
    .cw-close svg { width: 22px; height: 22px; }
    .cw-whatsapp { background: #25D366; }
    .cw-telegram { background: #2AABEE; }
    .cw-instagram { background: linear-gradient(45deg, #F9A03F, #E1306C 55%, #833AB4); }
    .cw-call { background: var(--color-accent, #6B4423); }
    .cw-close { background: var(--color-primary, #E8DCC7); color: var(--color-text, #2E2118); }

    @media (max-width: 480px) {
      .contact-widget { right: 14px; bottom: 14px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .cw-icon, .cw-panel, .cw-toggle, .cw-item, .cw-close { transition: none; }
    }
  </style>
</body>
</html>