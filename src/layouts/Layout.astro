---
import { getRelativeLocaleUrl } from 'astro:i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title: customTitle, description: customDescription } = Astro.props;

const currentLocale = Astro.currentLocale ?? 'pl';
const locales = ['pl', 'ru', 'en'];

let pathWithoutLocale = Astro.url.pathname.replace(/^\/(ru|en)(?=\/|$)/, '');
if (pathWithoutLocale === '') pathWithoutLocale = '/';

const navLabels = {
  pl: { home: 'Strona główna', catalog: 'Katalog', about: 'O nas', contact: 'Kontakt' },
  ru: { home: 'Главная', catalog: 'Каталог', about: 'О нас', contact: 'Контакты' },
  en: { home: 'Home', catalog: 'Catalog', about: 'About', contact: 'Contact' },
};
const nav = navLabels[currentLocale] ?? navLabels.pl;

const meta = {
  pl: {
    title: 'Charmel Flowers | Kwiaciarnia Warszawa',
    description: 'Bukiety, które robią wrażenie. Kwiaciarnia w Warszawie z realizacją w 15 minut.',
  },
  ru: {
    title: 'Charmel Flowers | Цветочный магазин в Варшаве',
    description: 'Цветочный магазин в Варшаве, где букет готов за 15 минут.',
  },
  en: {
    title: 'Charmel Flowers | Warsaw Flower Shop',
    description: 'A Warsaw flower shop with 15-minute bouquet preparation.',
  },
};
const m = meta[currentLocale] ?? meta.pl;
const pageTitle = customTitle ?? m.title;
const pageDescription = customDescription ?? m.description;

const footer = {
  pl: {
    heading: 'Charmel Flowers | Kwiaciarnia Warszawa',
    tagline: 'Bukiety, które robią wrażenie 🌺',
    delivery: '⚡ Bukiet gotowy w 15 minut • 🚗 Dostawa: Uber / Wolt',
    hoursTitle: 'Godziny otwarcia',
    hours: [
      { days: 'Pon\u2013Pt', time: '10:00\u201320:00' },
      { days: 'Sob', time: '10:00\u201318:00' },
      { days: 'Nie', time: '10:00\u201317:00' },
    ],
    rights: 'Wszelkie prawa zastrzeżone',
  },
  ru: {
    heading: 'Charmel Flowers | Цветочный магазин Варшава',
    tagline: 'Букеты, которые производят впечатление 🌺',
    delivery: '⚡ Букет готов за 15 минут • 🚗 Доставка: Uber / Wolt',
    hoursTitle: 'Часы работы',
    hours: [
      { days: 'Пн\u2013Пт', time: '10:00\u201320:00' },
      { days: 'Сб', time: '10:00\u201318:00' },
      { days: 'Вс', time: '10:00\u201317:00' },
    ],
    rights: 'Все права защищены',
  },
  en: {
    heading: 'Charmel Flowers | Warsaw Flower Shop',
    tagline: 'Bouquets that make an impression 🌺',
    delivery: '⚡ Bouquet ready in 15 minutes • 🚗 Delivery: Uber / Wolt',
    hoursTitle: 'Opening Hours',
    hours: [
      { days: 'Mon\u2013Fri', time: '10:00\u201320:00' },
      { days: 'Sat', time: '10:00\u201318:00' },
      { days: 'Sun', time: '10:00\u201317:00' },
    ],
    rights: 'All rights reserved',
  },
};
const f = footer[currentLocale] ?? footer.pl;
---

<html lang={currentLocale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <script is:inline>document.documentElement.classList.add('js-ready');</script>
  <script src="/cart.js" defer></script>
  <script src="/favorites.js" defer></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const revealEls = document.querySelectorAll('.reveal');
      if (revealEls.length) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });

        revealEls.forEach((el) => observer.observe(el));
      }

      const menuToggle = document.getElementById('mobile-menu-toggle');
      const navDropdown = document.getElementById('nav-dropdown');
      if (menuToggle && navDropdown) {
        menuToggle.addEventListener('click', () => {
          const isOpen = navDropdown.classList.toggle('is-open');
          menuToggle.classList.toggle('is-active', isOpen);
          menuToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
      }

      const langCurrentBtn = document.getElementById('lang-current-btn');
      const langOptions = document.getElementById('lang-options');
      const langSwitcher = document.getElementById('lang-switcher');
      if (langCurrentBtn && langOptions) {
        langCurrentBtn.addEventListener('click', () => {
          const isOpen = langOptions.classList.toggle('is-open');
          langCurrentBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
        document.addEventListener('click', (e) => {
          if (langSwitcher && !langSwitcher.contains(e.target)) {
            langOptions.classList.remove('is-open');
            langCurrentBtn.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // Lightbox — общий для всего сайта, включается классом .lightbox-trigger + data-images
      const lightbox = document.getElementById('site-lightbox');
      const lightboxImg = document.getElementById('lightbox-img');
      const lightboxCounter = document.getElementById('lightbox-counter');
      const lightboxPrev = document.getElementById('lightbox-prev');
      const lightboxNext = document.getElementById('lightbox-next');
      const lightboxClose = document.getElementById('lightbox-close');

      let currentImages = [];
      let currentIndex = 0;

      function updateLightboxImage() {
        lightboxImg.src = currentImages[currentIndex];
        const multi = currentImages.length > 1;
        lightboxCounter.textContent = multi ? `${currentIndex + 1} / ${currentImages.length}` : '';
        lightboxPrev.style.display = multi ? '' : 'none';
        lightboxNext.style.display = multi ? '' : 'none';
      }

      function openLightbox(images, startIndex) {
        currentImages = images;
        currentIndex = startIndex;
        updateLightboxImage();
        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
      }

      function closeLightbox() {
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
      }

      document.querySelectorAll('.lightbox-trigger').forEach((img) => {
        img.addEventListener('click', () => {
          const images = img.getAttribute('data-images').split(',');
          openLightbox(images, 0);
        });
      });

      lightboxClose.addEventListener('click', closeLightbox);
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
      lightboxPrev.addEventListener('click', () => {
        currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length;
        updateLightboxImage();
      });
      lightboxNext.addEventListener('click', () => {
        currentIndex = (currentIndex + 1) % currentImages.length;
        updateLightboxImage();
      });
      document.addEventListener('keydown', (e) => {
        if (!lightbox.classList.contains('is-open')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') lightboxPrev.click();
        if (e.key === 'ArrowRight') lightboxNext.click();
      });
    });
  </script>
</head>
<body>
  <div class="top-bar">
    <a href="tel:+48514011410" class="top-bar-phone">📞 +48 514 011 410</a>
  </div>

  <header class="site-header">
    <div class="header-inner">
      <a href={getRelativeLocaleUrl(currentLocale, '/')} class="logo-link">
        <img src="/images/logo-charmel.jpg" alt="Charmel Flowers" class="logo-img" />
        <span class="logo-text">Charmel Flowers</span>
      </a>

      <div class="nav-dropdown" id="nav-dropdown">
        <nav class="main-nav">
          <a href={getRelativeLocaleUrl(currentLocale, '/')}>{nav.home}</a>
          <a href={getRelativeLocaleUrl(currentLocale, '/catalog')}>{nav.catalog}</a>
          <a href={getRelativeLocaleUrl(currentLocale, '/about')}>{nav.about}</a>
          <a href={getRelativeLocaleUrl(currentLocale, '/contact')}>{nav.contact}</a>
        </nav>
      </div>

      <div class="header-right">
        <div class="lang-switcher" id="lang-switcher">
          <button class="lang-current" id="lang-current-btn" aria-expanded="false">
            {currentLocale.toUpperCase()} <span class="lang-arrow">▾</span>
          </button>
          <div class="lang-options" id="lang-options">
            {locales.filter((l) => l !== currentLocale).map((l) => (
              <a href={getRelativeLocaleUrl(l, pathWithoutLocale)}>{l.toUpperCase()}</a>
            ))}
          </div>
        </div>

        <a href={getRelativeLocaleUrl(currentLocale, '/favorites')} class="favorites-link" aria-label="Favorites">
          ♥ <span data-favorites-count>0</span>
        </a>
        <a href={getRelativeLocaleUrl(currentLocale, '/cart')} class="cart-link" aria-label="Cart">
          🛒 <span data-cart-count>0</span>
        </a>
        <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-col">
        <h4>{f.heading}</h4>
        <p class="footer-tagline">{f.tagline}</p>
        <p class="footer-delivery">{f.delivery}</p>
      </div>

      <div class="footer-col">
        <h4>{nav.contact}</h4>
        <p class="footer-contact">Stryjeńskich 6/lok.UH1B, 02-791 Warszawa</p>
        <a href="tel:+48514011410" class="footer-phone">+48 514 011 410</a>
        <div class="footer-social">
          <a href="https://www.instagram.com/charmelflowers/" target="_blank" rel="noopener" aria-label="Instagram">Instagram</a>
          <a href="https://wa.me/48514011410" target="_blank" rel="noopener" aria-label="WhatsApp">WhatsApp</a>
        </div>
      </div>

      <div class="footer-col">
        <h4>{f.hoursTitle}</h4>
        <div class="footer-hours">
          {f.hours.map((row) => (
            <p>{row.days}: {row.time}</p>
          ))}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 Charmel Flowers</p>
      <p class="footer-rights">{f.rights}</p>
    </div>
  </footer>

  <div class="lightbox" id="site-lightbox" aria-hidden="true">
    <button class="lightbox-close" id="lightbox-close" aria-label="Close">&times;</button>
    <button class="lightbox-prev" id="lightbox-prev" aria-label="Previous">&#8249;</button>
    <img src="" alt="" class="lightbox-img" id="lightbox-img" />
    <button class="lightbox-next" id="lightbox-next" aria-label="Next">&#8250;</button>
    <p class="lightbox-counter" id="lightbox-counter"></p>
  </div>
</body>
</html>