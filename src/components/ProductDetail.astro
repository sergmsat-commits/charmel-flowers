---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ADDONS } from '../data/addons';
import {
  PRODUCT_TEXT,
  paragraphs,
  photoAlt,
  photoUrl,
  absoluteUrl,
  speciesName,
  variantCartId,
  whatsappUrl,
  type Locale,
  type Product,
} from '../data/products';

interface Props {
  product: Product;
}
const { product } = Astro.props;
const currentLocale = (Astro.currentLocale ?? 'pl') as Locale;

const labels = {
  pl: {
    addToCart: 'Dodaj do koszyka',
    addons: 'Dodatki do bukietu',
    showMore: 'Zobacz więcej dodatków',
    showLess: 'Pokaż mniej',
    backToCatalog: '← Powrót do katalogu',
    currency: 'zł',
    sizeLabel: 'Rozmiar',
    compositionLabel: 'Skład bukietu',
  },
  ru: {
    addToCart: 'Добавить в корзину',
    addons: 'Дополнения к букету',
    showMore: 'Смотрите также',
    showLess: 'Скрыть',
    backToCatalog: '← Назад в каталог',
    currency: 'zł',
    sizeLabel: 'Размер',
    compositionLabel: 'Состав букета',
  },
  en: {
    addToCart: 'Add to cart',
    addons: 'Bouquet add-ons',
    showMore: 'See more',
    showLess: 'Show less',
    backToCatalog: '← Back to catalog',
    currency: 'zł',
    sizeLabel: 'Size',
    compositionLabel: 'Composition',
  },
};
const t = labels[currentLocale] ?? labels.pl;
const pt = PRODUCT_TEXT[currentLocale];

const addons = ADDONS;

const visibleAddons = addons.slice(0, 4);
const hiddenAddons = addons.slice(4);

const title = product.title[currentLocale];
const photos = product.photos;
const thumbs = photos.slice(1, 4);
// Лайтбокс: все фото в WebP до 1600 px
const lightboxUrls = await Promise.all(photos.map((p) => photoUrl(p, 1600)));
const allImages = lightboxUrls.join(',');
// Обложка для корзины
const cartCover = await photoUrl(photos[0], 400);

const catalogUrl = getRelativeLocaleUrl(currentLocale, '/catalog');

// Варианты товара (размер + цена). Пусто → «цена по запросу».
const variants = product.variants;
const hasMultipleVariants = variants.length > 1;
const defaultVariant = variants[0];

const descriptionParagraphs = paragraphs(product.description[currentLocale]);
const descriptionPlainText = descriptionParagraphs.map((p) => (p.label ? `${p.label}: ${p.text}` : p.text)).join(' ');

const productUrl = absoluteUrl(Astro.url.pathname);
const askUrl = whatsappUrl(product, currentLocale, productUrl);

const schemaAvailability = {
  'in-stock': 'https://schema.org/InStock',
  'made-to-order': 'https://schema.org/MadeToOrder',
  'out-of-stock': 'https://schema.org/OutOfStock',
}[product.availability];

const productSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: title,
  description: descriptionPlainText,
  image: (await Promise.all(photos.map((p) => photoUrl(p, 1200)))).map(absoluteUrl),
  sku: product.id,
  brand: { '@type': 'Brand', name: 'Charmel Flowers' },
  url: productUrl,
};
if (!product.priceOnRequest) {
  productSchema.offers = hasMultipleVariants
    ? {
        '@type': 'AggregateOffer',
        lowPrice: product.minPrice,
        highPrice: product.maxPrice,
        priceCurrency: 'PLN',
        offerCount: variants.length,
        availability: schemaAvailability,
        itemCondition: 'https://schema.org/NewCondition',
        url: productUrl,
      }
    : {
        '@type': 'Offer',
        price: defaultVariant.price,
        priceCurrency: 'PLN',
        availability: schemaAvailability,
        itemCondition: 'https://schema.org/NewCondition',
        url: productUrl,
        seller: { '@type': 'Organization', name: 'Charmel Flowers' },
      };
}
---

<section class="product-detail">
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <a href={catalogUrl} class="product-detail-back">{t.backToCatalog}</a>

  <div class="product-detail-layout">
    <div class="product-detail-image">
      <Image
        src={photos[0]}
        format="webp"
        widths={[600, 1000, 1400].filter((w) => w <= photos[0].width).concat(photos[0].width < 600 ? [photos[0].width] : [])}
        sizes="(max-width: 480px) 100vw, 480px"
        alt={photoAlt(product, currentLocale, 0)}
        class="lightbox-trigger product-detail-main-img"
        data-images={allImages}
        loading="eager"
        fetchpriority="high"
      />
      {thumbs.length > 0 && (
        <div class="product-detail-thumbs">
          {thumbs.map((img, i) => (
            <Image
              src={img}
              format="webp"
              width={Math.min(144, img.width)}
              alt={photoAlt(product, currentLocale, i + 1)}
              class="lightbox-trigger product-detail-thumb"
              data-images={allImages}
            />
          ))}
        </div>
      )}
    </div>

    <div class="product-detail-info">
      <h1>{title}</h1>

      {product.availability !== 'in-stock' && (
        <p class={`product-availability product-availability--${product.availability}`}>
          {product.availability === 'out-of-stock' ? pt.outOfStock : pt.madeToOrderNote}
        </p>
      )}

      <div class="product-detail-description">
        {descriptionParagraphs.map((p) => (
          <p>
            {p.label && <strong>{p.label}: </strong>}
            {p.text.split('\n').map((line, i) => (
              <>{i > 0 && <br />}{line}</>
            ))}
          </p>
        ))}
        {product.showNote && (
          <p class="product-note"><strong>{pt.noteLabel}: </strong>{pt.note}</p>
        )}
      </div>

      {product.priceOnRequest ? (
        <p class="product-detail-price" id="product-detail-price">{pt.priceOnRequest}</p>
      ) : (
        <p class="product-detail-price" id="product-detail-price">
          <s class="product-old-price" id="product-detail-old-price" hidden={!defaultVariant.oldPrice}>{defaultVariant.oldPrice ? `${defaultVariant.oldPrice} ${t.currency}` : ''}</s>
          <span id="product-detail-price-value">{defaultVariant.price} {t.currency}</span>
        </p>
      )}

      {hasMultipleVariants && (
        <div class="variant-selector">
          <span class="variant-selector-label">{t.sizeLabel}:</span>
          <div class="variant-options">
            {variants.map((v, i) => (
              <button
                type="button"
                class={`variant-option${i === 0 ? ' active' : ''}`}
                data-variant-size={v.size}
                data-variant-price={v.price}
                data-variant-old-price={v.oldPrice ?? ''}
              >
                {v.size}
              </button>
            ))}
          </div>
        </div>
      )}

      {!hasMultipleVariants && defaultVariant?.size && (
        <p class="product-detail-meta">
          <span class="product-detail-meta-label">{t.sizeLabel}:</span> <strong>{defaultVariant.size}</strong>
        </p>
      )}

      {product.composition.length > 0 && (
        <p class="product-detail-meta">
          <span class="product-detail-meta-label">{t.compositionLabel}:</span>{' '}
          {product.composition.map((slug) => speciesName(slug, currentLocale)).join(', ')}
        </p>
      )}

      {product.purchasable ? (
        <>
          <div class="addon-section">
            <h2>{t.addons}</h2>
            <div class="addon-grid">
              {visibleAddons.map((addon) => (
                <label class="addon-item">
                  <input
                    type="checkbox"
                    class="addon-checkbox"
                    data-addon-id={addon.id}
                    data-addon-title={addon.title[currentLocale]}
                    data-addon-price={addon.price}
                    data-addon-cover={addon.cover}
                  />
                  <img src={`/images/addons/${addon.cover}`} alt={addon.title[currentLocale]} />
                  <span class="addon-item-title">{addon.title[currentLocale]}</span>
                  <span class="addon-item-price">+{addon.price} {t.currency}</span>
                </label>
              ))}
            </div>

            <div class="addon-grid" id="addon-grid-hidden" style="display:none;">
              {hiddenAddons.map((addon) => (
                <label class="addon-item">
                  <input
                    type="checkbox"
                    class="addon-checkbox"
                    data-addon-id={addon.id}
                    data-addon-title={addon.title[currentLocale]}
                    data-addon-price={addon.price}
                    data-addon-cover={addon.cover}
                  />
                  <img src={`/images/addons/${addon.cover}`} alt={addon.title[currentLocale]} />
                  <span class="addon-item-title">{addon.title[currentLocale]}</span>
                  <span class="addon-item-price">+{addon.price} {t.currency}</span>
                </label>
              ))}
            </div>

            <button
              type="button"
              class="addon-toggle-btn"
              id="addon-toggle-btn"
              data-show-more={t.showMore}
              data-show-less={t.showLess}
            >
              {t.showMore}
            </button>
          </div>

          <button
            type="button"
            class="add-to-cart-btn product-detail-add-btn"
            id="product-detail-add-btn"
            data-product-id={product.id}
            data-base-title={title}
            data-id={variantCartId(product, defaultVariant)}
            data-title={hasMultipleVariants ? `${title} (${defaultVariant.size})` : title}
            data-price={defaultVariant.price}
            data-cover={cartCover}
          >
            {t.addToCart}
          </button>
        </>
      ) : (
        <a href={askUrl} target="_blank" rel="noopener" class="add-to-cart-btn product-detail-add-btn ask-whatsapp-btn">{pt.askWhatsApp}</a>
      )}
    </div>
  </div>
</section>

<style>
  .product-detail-thumbs {
    display: flex;
    gap: 10px;
    margin-top: 12px;
  }

  .product-detail-thumb {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 6px;
    cursor: pointer;
    border: 1px solid var(--color-primary-dark);
    transition: opacity 0.2s ease;
  }

  .product-detail-thumb:hover {
    opacity: 0.8;
  }

  .product-detail-description p {
    margin-bottom: 12px;
  }

  .product-detail-description p strong {
    color: var(--color-accent);
  }

  .product-detail-meta {
    font-family: var(--font-body);
    color: var(--color-text);
    font-size: 0.95rem;
    margin: 4px 0;
  }

  .product-detail-meta-label {
    color: var(--color-accent);
  }

  .variant-selector {
    margin: 10px 0 16px;
  }

  .variant-selector-label {
    display: block;
    font-family: var(--font-body);
    color: var(--color-accent);
    font-size: 0.95rem;
    margin-bottom: 8px;
  }

  .variant-options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .variant-option {
    font-family: var(--font-body);
    background: var(--color-primary);
    color: var(--color-text);
    border: 1px solid var(--color-primary-dark);
    border-radius: 999px;
    padding: 8px 16px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .variant-option.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-white);
  }
  .product-old-price {
    color: #999;
    font-weight: normal;
    font-size: 0.8em;
    margin-right: 8px;
  }

  .product-availability {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.9rem;
    border-radius: 8px;
    padding: 8px 12px;
    margin: 0 0 16px;
  }

  .product-availability--out-of-stock {
    background: #f3e3e3;
    color: #8a2c2c;
    font-weight: bold;
  }

  .product-availability--made-to-order {
    background: var(--color-primary);
    color: var(--color-accent);
  }

  /* Astro Image ставит width/height — высоту считаем по пропорциям фото */
  .product-detail-image :global(img.product-detail-main-img) {
    height: auto;
  }

  a.ask-whatsapp-btn {
    display: block;
    text-align: center;
    text-decoration: none;
    background-color: #25d366;
  }
</style>

<script>
  const toggleBtn = document.getElementById('addon-toggle-btn');
  const hiddenGrid = document.getElementById('addon-grid-hidden');
  if (toggleBtn && hiddenGrid) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = hiddenGrid.style.display === 'none';
      hiddenGrid.style.display = isHidden ? '' : 'none';
      toggleBtn.textContent = isHidden
        ? toggleBtn.getAttribute('data-show-less')
        : toggleBtn.getAttribute('data-show-more');
    });
  }

  const addBtn = document.getElementById('product-detail-add-btn');
  const variantButtons = document.querySelectorAll('.variant-option');

  variantButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      variantButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const size = btn.getAttribute('data-variant-size');
      const price = btn.getAttribute('data-variant-price');
      const oldPrice = btn.getAttribute('data-variant-old-price');

      const priceValueEl = document.getElementById('product-detail-price-value');
      const oldPriceEl = document.getElementById('product-detail-old-price');
      if (priceValueEl) {
        priceValueEl.textContent = `${price} zł`;
      }
      if (oldPriceEl) {
        oldPriceEl.textContent = oldPrice ? `${oldPrice} zł` : '';
        oldPriceEl.hidden = !oldPrice;
      }
      if (addBtn) {
        const productId = addBtn.getAttribute('data-product-id');
        const baseTitle = addBtn.getAttribute('data-base-title');
        addBtn.setAttribute('data-id', `${productId}--${size}`);
        addBtn.setAttribute('data-price', price);
        addBtn.setAttribute('data-title', `${baseTitle} (${size})`);
      }
    });
  });

  if (addBtn) {
    const originalText = addBtn.textContent;
    addBtn.addEventListener('click', () => {
      if (!window.AuraCart) return;
      window.AuraCart.addItem({
        id: addBtn.getAttribute('data-id'),
        title: addBtn.getAttribute('data-title'),
        price: Number(addBtn.getAttribute('data-price')),
        cover: addBtn.getAttribute('data-cover'),
      });
      document.querySelectorAll('.addon-checkbox:checked').forEach((cb) => {
        window.AuraCart.addItem({
          id: cb.getAttribute('data-addon-id'),
          title: cb.getAttribute('data-addon-title'),
          price: Number(cb.getAttribute('data-addon-price')),
          cover: cb.getAttribute('data-addon-cover'),
        });
      });
      addBtn.textContent = '✓';
      setTimeout(() => {
        addBtn.textContent = originalText;
      }, 1200);
    });
  }
</script>
