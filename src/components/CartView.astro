---
const currentLocale = Astro.currentLocale ?? 'pl';

const content = {
  pl: {
    title: 'Koszyk', empty: 'Twój koszyk jest pusty.', remove: 'Usuń', total: 'Razem',
    formTitle: 'Dane do zamówienia',
    buyerHeading: 'Dane zamawiającego',
    buyerName: 'Imię i nazwisko',
    buyerPhone: 'Telefon',
    recipientSelf: 'To zamówienie dla mnie (odbiorca = zamawiający)',
    recipientHeading: 'Dane odbiorcy',
    recipientName: 'Imię i nazwisko odbiorcy',
    recipientPhone: 'Telefon odbiorcy',
    fulfillmentLabel: 'Sposób odbioru',
    deliveryOption: 'Dostawa',
    pickupOption: 'Odbiór osobisty (Kabaty)',
    address: 'Adres dostawy',
    pickupNote: 'Odbiór pod adresem: Stryjeńskich 6/lok.UH1B, Kabaty',
    date: 'Data', time: 'Godzina',
    paymentLabel: 'Sposób płatności',
    paymentBlik: 'BLIK',
    paymentCash: 'Gotówka',
    comment: 'Komentarz (opcjonalnie)',
    consent: 'Wyrażam zgodę na przetwarzanie moich danych osobowych w celu realizacji zamówienia (zgodnie z RODO).',
    submit: 'Złóż zamówienie', sending: 'Wysyłanie...',
    success: 'Dziękujemy! Twoje zamówienie zostało wysłane.',
    error: 'Coś poszło nie tak. Spróbuj ponownie lub napisz do nas na Instagramie.',
  },
  ru: {
    title: 'Корзина', empty: 'Ваша корзина пуста.', remove: 'Удалить', total: 'Итого',
    formTitle: 'Данные для заказа',
    buyerHeading: 'Данные заказчика',
    buyerName: 'Имя и фамилия',
    buyerPhone: 'Телефон',
    recipientSelf: 'Этот заказ для меня (получатель = заказчик)',
    recipientHeading: 'Данные получателя',
    recipientName: 'Имя и фамилия получателя',
    recipientPhone: 'Телефон получателя',
    fulfillmentLabel: 'Способ получения',
    deliveryOption: 'Доставка',
    pickupOption: 'Самовывоз (Кабаты)',
    address: 'Адрес доставки',
    pickupNote: 'Самовывоз по адресу: Stryjeńskich 6/lok.UH1B, Кабаты',
    date: 'Дата', time: 'Время',
    paymentLabel: 'Способ оплаты',
    paymentBlik: 'BLIK',
    paymentCash: 'Наличными',
    comment: 'Комментарий (необязательно)',
    consent: 'Я даю согласие на обработку моих персональных данных для оформления заказа (в соответствии с RODO/GDPR).',
    submit: 'Оформить заказ', sending: 'Отправка...',
    success: 'Спасибо! Ваш заказ отправлен.',
    error: 'Что-то пошло не так. Попробуйте ещё раз или напишите нам в Instagram.',
  },
  en: {
    title: 'Cart', empty: 'Your cart is empty.', remove: 'Remove', total: 'Total',
    formTitle: 'Order details',
    buyerHeading: "Orderer's details",
    buyerName: 'Full name',
    buyerPhone: 'Phone',
    recipientSelf: 'This order is for me (recipient = orderer)',
    recipientHeading: "Recipient's details",
    recipientName: "Recipient's full name",
    recipientPhone: "Recipient's phone",
    fulfillmentLabel: 'Fulfillment method',
    deliveryOption: 'Delivery',
    pickupOption: 'Pickup (Kabaty)',
    address: 'Delivery address',
    pickupNote: 'Pickup at: Stryjeńskich 6/lok.UH1B, Kabaty',
    date: 'Date', time: 'Time',
    paymentLabel: 'Payment method',
    paymentBlik: 'BLIK',
    paymentCash: 'Cash',
    comment: 'Comment (optional)',
    consent: 'I agree to the processing of my personal data for the purpose of order fulfillment (in accordance with GDPR).',
    submit: 'Place order', sending: 'Sending...',
    success: 'Thank you! Your order has been sent.',
    error: 'Something went wrong. Please try again or message us on Instagram.',
  },
};
const t = content[currentLocale] ?? content.pl;
---

<section class="cart-section">
  <h1>{t.title}</h1>
  <div id="cart-items"></div>
  <p id="cart-empty-msg" class="cart-empty" style="display:none;">{t.empty}</p>
  <div class="cart-total">
    <strong>{t.total}: <span id="cart-total-value">0</span> zł</strong>
  </div>

  <form id="order-form" class="order-form">
    <h2>{t.formTitle}</h2>

    <h3 class="order-form-subheading">{t.buyerHeading}</h3>
    <div class="order-form-row">
      <label>
        {t.buyerName}
        <input type="text" name="buyerName" id="buyer-name-input" required />
      </label>
      <label>
        {t.buyerPhone}
        <input type="tel" name="buyerPhone" id="buyer-phone-input" required />
      </label>
    </div>

    <label class="order-form-checkbox">
      <input type="checkbox" name="recipientIsMe" id="recipient-is-me" />
      <span>{t.recipientSelf}</span>
    </label>

    <div id="recipient-fields">
      <h3 class="order-form-subheading">{t.recipientHeading}</h3>
      <div class="order-form-row">
        <label>
          {t.recipientName}
          <input type="text" name="recipientName" id="recipient-name-input" required />
        </label>
        <label>
          {t.recipientPhone}
          <input type="tel" name="recipientPhone" id="recipient-phone-input" required />
        </label>
      </div>
    </div>

    <div class="order-form-field">
      <span class="field-label">{t.fulfillmentLabel}</span>
      <div class="toggle-group" data-group="fulfillment">
        <label class="toggle-option active">
          <input type="radio" name="fulfillment" value="delivery" checked />
          {t.deliveryOption}
        </label>
        <label class="toggle-option">
          <input type="radio" name="fulfillment" value="pickup" />
          {t.pickupOption}
        </label>
      </div>
    </div>

    <label id="recipient-address-field">
      {t.address}
      <input type="text" name="recipientAddress" id="recipient-address-input" required />
    </label>

    <p id="pickup-note" class="pickup-note" style="display:none;">{t.pickupNote}</p>

    <div class="order-form-row">
      <label>
        {t.date}
        <input type="date" name="date" id="order-date" required />
      </label>

      <label>
        {t.time}
        <input type="time" name="time" min="09:00" max="21:00" required />
      </label>
    </div>

    <div class="order-form-field">
      <span class="field-label">{t.paymentLabel}</span>
      <div class="toggle-group" data-group="payment">
        <label class="toggle-option active">
          <input type="radio" name="payment" value="blik" checked />
          {t.paymentBlik}
        </label>
        <label class="toggle-option">
          <input type="radio" name="payment" value="cash" />
          {t.paymentCash}
        </label>
      </div>
    </div>

    <label>
      {t.comment}
      <textarea name="comment" rows="3"></textarea>
    </label>

    <label class="order-form-checkbox">
      <input type="checkbox" name="consent" required />
      <span>{t.consent}</span>
    </label>

    <button type="submit" id="order-submit-btn">{t.submit}</button>
    <p id="order-status-msg" class="order-status-msg"></p>
  </form>
</section>

<script define:vars={{ removeLabel: t.remove, sendingLabel: t.sending, submitLabel: t.submit, successMsg: t.success, errorMsg: t.error, paymentBlikLabel: t.paymentBlik, paymentCashLabel: t.paymentCash, pickupNoteText: t.pickupNote }}>
  // TODO: перед деплоем заменить на токен и chat_id НОВОГО бота Charmel Flowers
  const BOT_TOKEN = '8747627753:AAESE4LS6x6uN2ZszncOJ5yDiLcsuLuD3OI';
  const CHAT_ID = '1875800818';

  function renderCart() {
    if (!window.AuraCart) return;
    const cart = window.AuraCart.getCart();
    const container = document.getElementById('cart-items');
    const emptyMsg = document.getElementById('cart-empty-msg');
    const totalEl = document.getElementById('cart-total-value');
    const form = document.getElementById('order-form');
    if (!container) return;

    container.innerHTML = '';

    if (cart.length === 0) {
      emptyMsg.style.display = 'block';
      form.style.display = 'none';
    } else {
      emptyMsg.style.display = 'none';
      form.style.display = 'block';
      cart.forEach((item) => {
        const row = document.createElement('div');
        row.className = 'cart-row';
        row.innerHTML = `
          <img src="/images/products/${item.cover}" alt="${item.title}" class="cart-row-img" />
          <div class="cart-row-info">
            <p class="cart-row-title">${item.title}</p>
            <p class="cart-row-price">${item.price} zł</p>
          </div>
          <div class="cart-row-qty">
            <button type="button" class="qty-btn" data-action="decrease" data-id="${item.id}">−</button>
            <span>${item.qty}</span>
            <button type="button" class="qty-btn" data-action="increase" data-id="${item.id}">+</button>
          </div>
          <button type="button" class="cart-remove-btn" data-id="${item.id}">${removeLabel}</button>
        `;
        container.appendChild(row);
      });
    }

    totalEl.textContent = window.AuraCart.getTotal();

    container.querySelectorAll('.qty-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        const cart = window.AuraCart.getCart();
        const item = cart.find((i) => i.id === id);
        if (!item) return;
        const delta = btn.getAttribute('data-action') === 'increase' ? 1 : -1;
        window.AuraCart.updateQty(id, item.qty + delta);
        renderCart();
      });
    });

    container.querySelectorAll('.cart-remove-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        window.AuraCart.removeItem(btn.getAttribute('data-id'));
        renderCart();
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderCart();
    const dateInput = document.getElementById('order-date');
    if (dateInput) {
      dateInput.min = new Date().toISOString().split('T')[0];
    }
  });
  window.addEventListener('cart:updated', renderCart);

  // "Это заказ для меня" — скрывает поля получателя
  const selfCheckbox = document.getElementById('recipient-is-me');
  const recipientFields = document.getElementById('recipient-fields');
  const recipientNameInput = document.getElementById('recipient-name-input');
  const recipientPhoneInput = document.getElementById('recipient-phone-input');
  if (selfCheckbox) {
    selfCheckbox.addEventListener('change', () => {
      const isSelf = selfCheckbox.checked;
      recipientFields.style.display = isSelf ? 'none' : '';
      recipientNameInput.required = !isSelf;
      recipientPhoneInput.required = !isSelf;
    });
  }

  // Переключатели (доставка/самовывоз, BLIK/наличные) — единый стиль пилюль
  document.querySelectorAll('.toggle-group').forEach((group) => {
    const options = group.querySelectorAll('.toggle-option');
    options.forEach((opt) => {
      opt.addEventListener('click', () => {
        options.forEach((o) => o.classList.remove('active'));
        opt.classList.add('active');
        opt.querySelector('input').checked = true;

        if (group.getAttribute('data-group') === 'fulfillment') {
          const value = opt.querySelector('input').value;
          const addressField = document.getElementById('recipient-address-field');
          const addressInput = document.getElementById('recipient-address-input');
          const pickupNote = document.getElementById('pickup-note');
          const isPickup = value === 'pickup';
          addressField.style.display = isPickup ? 'none' : '';
          addressInput.required = !isPickup;
          pickupNote.style.display = isPickup ? 'block' : 'none';
        }
      });
    });
  });

  const orderForm = document.getElementById('order-form');
  if (orderForm) {
    orderForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('order-submit-btn');
      const statusMsg = document.getElementById('order-status-msg');
      const formData = new FormData(orderForm);
      const cart = window.AuraCart.getCart();

      const itemsText = cart.map((i) => `- ${i.title} x${i.qty} — ${i.price * i.qty} zł`).join('\n');
      const total = window.AuraCart.getTotal();

      const isSelf = formData.get('recipientIsMe') === 'on';
      const buyerName = formData.get('buyerName');
      const buyerPhone = formData.get('buyerPhone');
      const recipientName = isSelf ? buyerName : formData.get('recipientName');
      const recipientPhone = isSelf ? buyerPhone : formData.get('recipientPhone');

      const fulfillment = formData.get('fulfillment');
      const fulfillmentLabel = fulfillment === 'pickup' ? 'Самовывоз (Кабаты)' : 'Доставка';
      const addressLine = fulfillment === 'pickup'
        ? pickupNoteText
        : `Адрес доставки: ${formData.get('recipientAddress')}`;

      const payment = formData.get('payment');
      const paymentLabel = payment === 'blik' ? paymentBlikLabel : paymentCashLabel;

      const text = `🌸 Новый заказ (Charmel Flowers)\n\n${itemsText}\n\nИтого: ${total} zł\n\n— Заказчик —\nИмя: ${buyerName}\nТелефон: ${buyerPhone}\n\n— Получатель —\nИмя: ${recipientName}\nТелефон: ${recipientPhone}\n\nСпособ получения: ${fulfillmentLabel}\n${addressLine}\n\nДата: ${formData.get('date')}\nВремя: ${formData.get('time')}\nОплата: ${paymentLabel}\nКомментарий: ${formData.get('comment') || '—'}\nСогласие на обработку данных: получено`;

      submitBtn.disabled = true;
      submitBtn.textContent = sendingLabel;
      statusMsg.textContent = '';

      try {
        const res = await fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ chat_id: CHAT_ID, text }),
        });
        if (!res.ok) throw new Error('Telegram API error');

        statusMsg.textContent = successMsg;
        statusMsg.className = 'order-status-msg success';
        window.AuraCart.clearCart();
        orderForm.reset();
      } catch (err) {
        statusMsg.textContent = errorMsg;
        statusMsg.className = 'order-status-msg error';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = submitLabel;
      }
    });
  }
</script>