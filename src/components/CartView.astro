---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { COMPANY } from '../data/company';

const currentLocale = Astro.currentLocale ?? 'pl';

// Заказ отправляется на сервер (/api/order, папка functions/), а не напрямую в Telegram:
// токен бота и ключи Przelewy24 хранятся только в переменных Cloudflare.

const content = {
  pl: {
    title: 'Koszyk', empty: 'Twój koszyk jest pusty.', remove: 'Usuń', total: 'Razem',
    formTitle: 'Dane do zamówienia',
    buyerHeading: 'Dane zamawiającego',
    buyerName: 'Imię i nazwisko',
    buyerPhone: 'Telefon',
    buyerEmail: 'E-mail (wyślemy potwierdzenie zamówienia)',
    recipientSelf: 'To zamówienie dla mnie (odbiorca = zamawiający)',
    recipientHeading: 'Dane odbiorcy',
    recipientName: 'Imię i nazwisko odbiorcy',
    recipientPhone: 'Telefon odbiorcy',
    fulfillmentLabel: 'Sposób odbioru',
    deliveryOption: 'Dostawa',
    pickupOption: 'Odbiór osobisty (Kabaty)',
    deliveryNote: 'Zobacz sekcję DOSTAWA I PŁATNOŚĆ',
    address: 'Adres dostawy',
    pickupNote: 'Odbiór pod adresem: Stryjeńskich 6/lok.UH1B, Kabaty',
    date: 'Data', time: 'Godzina',
    paymentLabel: 'Sposób płatności',
    paymentOnline: 'Płatność online (BLIK, karta, przelew)',
    paymentCash: 'Gotówka lub karta w pracowni (tylko odbiór osobisty)',
    deliveryCostNote: 'Koszt dostawy (Uber/Wolt) zależy od adresu — potwierdzimy go po złożeniu zamówienia.',
    comment: 'Komentarz (opcjonalnie)',
    acceptPre: 'Oświadczam, że zapoznałem/am się z ', acceptLink: 'Regulaminem sklepu', acceptPost: ' i akceptuję jego postanowienia.',
    privacyPre: `Administratorem Twoich danych osobowych jest ${COMPANY.name}. Dane przetwarzamy w celu realizacji zamówienia. Szczegóły: `, privacyLink: 'Polityka prywatności', privacyPost: '.',
    submit: 'Zamawiam i płacę', sending: 'Wysyłanie...',
    success: 'Dziękujemy! Twoje zamówienie zostało przyjęte. Wkrótce się z Tobą skontaktujemy.',
    redirecting: 'Przekierowujemy do płatności Przelewy24…',
    error: 'Coś poszło nie tak. Spróbuj ponownie lub zadzwoń do nas: +48 514 011 410.',
  },
  ru: {
    title: 'Корзина', empty: 'Ваша корзина пуста.', remove: 'Удалить', total: 'Итого',
    formTitle: 'Данные для заказа',
    buyerHeading: 'Данные заказчика',
    buyerName: 'Имя и фамилия',
    buyerPhone: 'Телефон',
    buyerEmail: 'E-mail (пришлём подтверждение заказа)',
    recipientSelf: 'Этот заказ для меня (получатель = заказчик)',
    recipientHeading: 'Данные получателя',
    recipientName: 'Имя и фамилия получателя',
    recipientPhone: 'Телефон получателя',
    fulfillmentLabel: 'Способ получения',
    deliveryOption: 'Доставка',
    pickupOption: 'Самовывоз (Кабаты)',
    deliveryNote: 'Смотри раздел ДОСТАВКА И ОПЛАТА',
    address: 'Адрес доставки',
    pickupNote: 'Самовывоз по адресу: Stryjeńskich 6/lok.UH1B, Кабаты',
    date: 'Дата', time: 'Время',
    paymentLabel: 'Способ оплаты',
    paymentOnline: 'Онлайн-оплата (BLIK, карта, перевод)',
    paymentCash: 'Наличные или карта в студии (только самовывоз)',
    deliveryCostNote: 'Стоимость доставки (Uber/Wolt) зависит от адреса — мы подтвердим её после оформления заказа.',
    comment: 'Комментарий (необязательно)',
    acceptPre: 'Заявляю, что ознакомлен(а) с ', acceptLink: 'Правилами магазина (Regulamin)', acceptPost: ' и принимаю их.',
    privacyPre: `Администратор ваших персональных данных — ${COMPANY.name}. Мы обрабатываем данные для выполнения заказа. Подробнее: `, privacyLink: 'Политика конфиденциальности', privacyPost: '.',
    submit: 'Заказать с обязательством оплаты', sending: 'Отправка...',
    success: 'Спасибо! Ваш заказ принят. Мы скоро свяжемся с вами.',
    redirecting: 'Переходим к оплате Przelewy24…',
    error: 'Что-то пошло не так. Попробуйте ещё раз или позвоните нам: +48 514 011 410.',
  },
  en: {
    title: 'Cart', empty: 'Your cart is empty.', remove: 'Remove', total: 'Total',
    formTitle: 'Order details',
    buyerHeading: "Orderer's details",
    buyerName: 'Full name',
    buyerPhone: 'Phone',
    buyerEmail: 'E-mail (we will send the order confirmation)',
    recipientSelf: 'This order is for me (recipient = orderer)',
    recipientHeading: "Recipient's details",
    recipientName: "Recipient's full name",
    recipientPhone: "Recipient's phone",
    fulfillmentLabel: 'Fulfillment method',
    deliveryOption: 'Delivery',
    pickupOption: 'Pickup (Kabaty)',
    deliveryNote: 'See the DELIVERY & PAYMENT section',
    address: 'Delivery address',
    pickupNote: 'Pickup at: Stryjeńskich 6/lok.UH1B, Kabaty',
    date: 'Date', time: 'Time',
    paymentLabel: 'Payment method',
    paymentOnline: 'Pay online (BLIK, card, bank transfer)',
    paymentCash: 'Cash or card at the studio (pickup only)',
    deliveryCostNote: 'Delivery cost (Uber/Wolt) depends on the address — we will confirm it after you place the order.',
    comment: 'Comment (optional)',
    acceptPre: 'I declare that I have read and accept the ', acceptLink: 'Terms and Conditions (Regulamin)', acceptPost: '.',
    privacyPre: `The controller of your personal data is ${COMPANY.name}. We process your data to fulfil your order. Details: `, privacyLink: 'Privacy Policy', privacyPost: '.',
    submit: 'Order with obligation to pay', sending: 'Sending...',
    success: 'Thank you! Your order has been received. We will contact you shortly.',
    redirecting: 'Redirecting to Przelewy24 payment…',
    error: 'Something went wrong. Please try again or call us: +48 514 011 410.',
  },
};
const t = content[currentLocale] ?? content.pl;
const deliveryPageUrl = getRelativeLocaleUrl(currentLocale, '/delivery');
const regulaminUrl = getRelativeLocaleUrl(currentLocale, '/regulamin');
const privacyUrl = getRelativeLocaleUrl(currentLocale, '/polityka-prywatnosci');
---

<section class="cart-section">
  <h1>{t.title}</h1>
  <div id="cart-items"></div>
  <p id="cart-empty-msg" class="cart-empty" style="display:none;">{t.empty}</p>
  <div class="cart-total">
    <strong>{t.total}: <span id="cart-total-value">0</span> zł</strong>
  </div>
  <p class="delivery-cost-note" id="delivery-cost-note">{t.deliveryCostNote}</p>

  <form id="order-form" class="order-form">
    <h2>{t.formTitle}</h2>

    <h3 class="order-form-subheading">{t.buyerHeading}</h3>
    <div class="order-form-row">
      <label>
        {t.buyerName}
        <input type="text" name="buyerName" id="buyer-name-input" required />
      </label>
      <label>
        {t.buyerPhone}
        <input type="tel" name="buyerPhone" id="buyer-phone-input" required />
      </label>
    </div>

    <label>
      {t.buyerEmail}
      <input type="email" name="buyerEmail" id="buyer-email-input" autocomplete="email" required />
    </label>

    <label class="order-form-checkbox">
      <input type="checkbox" name="recipientIsMe" id="recipient-is-me" />
      <span>{t.recipientSelf}</span>
    </label>

    <div id="recipient-fields">
      <h3 class="order-form-subheading">{t.recipientHeading}</h3>
      <div class="order-form-row">
        <label>
          {t.recipientName}
          <input type="text" name="recipientName" id="recipient-name-input" required />
        </label>
        <label>
          {t.recipientPhone}
          <input type="tel" name="recipientPhone" id="recipient-phone-input" required />
        </label>
      </div>
    </div>

    <div class="order-form-field">
      <span class="field-label">{t.fulfillmentLabel}</span>
      <div class="toggle-group" data-group="fulfillment">
        <label class="toggle-option active">
          <input type="radio" name="fulfillment" value="delivery" checked />
          {t.deliveryOption}
        </label>
        <label class="toggle-option">
          <input type="radio" name="fulfillment" value="pickup" />
          {t.pickupOption}
        </label>
      </div>
    </div>

    <p class="delivery-info-note">
      * <a href={deliveryPageUrl} target="_blank" rel="noopener">{t.deliveryNote}</a>
    </p>

    <label id="recipient-address-field">
      {t.address}
      <input type="text" name="recipientAddress" id="recipient-address-input" required />
    </label>

    <p id="pickup-note" class="pickup-note" style="display:none;">{t.pickupNote}</p>

    <div class="order-form-row">
      <label>
        {t.date}
        <input type="date" name="date" id="order-date" required />
      </label>

      <label>
        {t.time}
        <input type="time" name="time" min="09:00" max="21:00" required />
      </label>
    </div>

    <div class="order-form-field">
      <span class="field-label">{t.paymentLabel}</span>
      <div class="toggle-group" data-group="payment">
        <label class="toggle-option active">
          <input type="radio" name="payment" value="online" checked />
          {t.paymentOnline}
        </label>
        <label class="toggle-option" id="payment-cash-option" style="display:none;">
          <input type="radio" name="payment" value="cash" />
          {t.paymentCash}
        </label>
      </div>
    </div>

    <label>
      {t.comment}
      <textarea name="comment" rows="3"></textarea>
    </label>

    <label class="order-form-checkbox">
      <input type="checkbox" name="acceptRegulamin" required />
      <span>{t.acceptPre}<a href={regulaminUrl} target="_blank" rel="noopener" class="legal-link">{t.acceptLink}</a>{t.acceptPost}</span>
    </label>

    <p class="privacy-info">
      {t.privacyPre}<a href={privacyUrl} target="_blank" rel="noopener" class="legal-link">{t.privacyLink}</a>{t.privacyPost}
    </p>

    <button type="submit" id="order-submit-btn">{t.submit}</button>
    <p id="order-status-msg" class="order-status-msg"></p>
  </form>
</section>

<style>
  .delivery-info-note {
    margin: 8px 0 16px;
  }

  .delivery-info-note a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .legal-link {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .delivery-cost-note {
    font-size: 0.85rem;
    opacity: 0.8;
    margin: -4px 0 16px;
  }

  .privacy-info {
    font-size: 0.85rem;
    opacity: 0.85;
    margin: 4px 0 16px;
  }
</style>

<script define:vars={{ removeLabel: t.remove, sendingLabel: t.sending, submitLabel: t.submit, successMsg: t.success, errorMsg: t.error, redirectingMsg: t.redirecting, locale: currentLocale }}>

  function renderCart() {
    if (!window.AuraCart) return;
    const cart = window.AuraCart.getCart();
    const container = document.getElementById('cart-items');
    const emptyMsg = document.getElementById('cart-empty-msg');
    const totalEl = document.getElementById('cart-total-value');
    const form = document.getElementById('order-form');
    if (!container) return;

    container.innerHTML = '';

    if (cart.length === 0) {
      emptyMsg.style.display = 'block';
      form.style.display = 'none';
    } else {
      emptyMsg.style.display = 'none';
      form.style.display = 'block';
      cart.forEach((item) => {
        const row = document.createElement('div');
        row.className = 'cart-row';
        row.innerHTML = `
          <img src="${item.id.startsWith('addon-') ? '/images/addons/' : '/images/products/'}${item.cover}" alt="${item.title}" class="cart-row-img" />
          <div class="cart-row-info">
            <p class="cart-row-title">${item.title}</p>
            <p class="cart-row-price">${item.price} zł</p>
          </div>
          <div class="cart-row-qty">
            <button type="button" class="qty-btn" data-action="decrease" data-id="${item.id}">−</button>
            <span>${item.qty}</span>
            <button type="button" class="qty-btn" data-action="increase" data-id="${item.id}">+</button>
          </div>
          <button type="button" class="cart-remove-btn" data-id="${item.id}">${removeLabel}</button>
        `;
        container.appendChild(row);
      });
    }

    totalEl.textContent = window.AuraCart.getTotal();

    container.querySelectorAll('.qty-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        const cart = window.AuraCart.getCart();
        const item = cart.find((i) => i.id === id);
        if (!item) return;
        const delta = btn.getAttribute('data-action') === 'increase' ? 1 : -1;
        window.AuraCart.updateQty(id, item.qty + delta);
        renderCart();
      });
    });

    container.querySelectorAll('.cart-remove-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        window.AuraCart.removeItem(btn.getAttribute('data-id'));
        renderCart();
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderCart();
    const dateInput = document.getElementById('order-date');
    if (dateInput) {
      dateInput.min = new Date().toISOString().split('T')[0];
    }
  });
  window.addEventListener('cart:updated', renderCart);

  // "Это заказ для меня" — скрывает поля получателя
  const selfCheckbox = document.getElementById('recipient-is-me');
  const recipientFields = document.getElementById('recipient-fields');
  const recipientNameInput = document.getElementById('recipient-name-input');
  const recipientPhoneInput = document.getElementById('recipient-phone-input');
  if (selfCheckbox) {
    selfCheckbox.addEventListener('change', () => {
      const isSelf = selfCheckbox.checked;
      recipientFields.style.display = isSelf ? 'none' : '';
      recipientNameInput.required = !isSelf;
      recipientPhoneInput.required = !isSelf;
    });
  }

  // Переключатели (доставка/самовывоз, BLIK/наличные) — единый стиль пилюль
  document.querySelectorAll('.toggle-group').forEach((group) => {
    const options = group.querySelectorAll('.toggle-option');
    options.forEach((opt) => {
      opt.addEventListener('click', () => {
        options.forEach((o) => o.classList.remove('active'));
        opt.classList.add('active');
        opt.querySelector('input').checked = true;

        if (group.getAttribute('data-group') === 'fulfillment') {
          const value = opt.querySelector('input').value;
          const addressField = document.getElementById('recipient-address-field');
          const addressInput = document.getElementById('recipient-address-input');
          const pickupNote = document.getElementById('pickup-note');
          const isPickup = value === 'pickup';
          addressField.style.display = isPickup ? 'none' : '';
          addressInput.required = !isPickup;
          pickupNote.style.display = isPickup ? 'block' : 'none';

          const deliveryCostNote = document.getElementById('delivery-cost-note');
          if (deliveryCostNote) deliveryCostNote.style.display = isPickup ? 'none' : '';

          // Оплата в студии (наличные/карта) — только при самовывозе
          const cashOption = document.getElementById('payment-cash-option');
          if (cashOption) {
            cashOption.style.display = isPickup ? '' : 'none';
            const cashInput = cashOption.querySelector('input');
            if (!isPickup && cashInput && cashInput.checked) {
              const paymentGroup = cashOption.closest('.toggle-group');
              const blikOption = paymentGroup ? paymentGroup.querySelector('input[value="online"]') : null;
              if (blikOption) {
                paymentGroup.querySelectorAll('.toggle-option').forEach((o) => o.classList.remove('active'));
                blikOption.checked = true;
                blikOption.closest('.toggle-option').classList.add('active');
              }
            }
          }
        }
      });
    });
  });

  // Если покупатель вернулся из Przelewy24 кнопкой «Назад» — снова включаем кнопку заказа
  window.addEventListener('pageshow', () => {
    const btn = document.getElementById('order-submit-btn');
    if (btn) {
      btn.disabled = false;
      btn.textContent = submitLabel;
    }
  });

  const orderForm = document.getElementById('order-form');
  if (orderForm) {
    orderForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('order-submit-btn');
      const statusMsg = document.getElementById('order-status-msg');
      const formData = new FormData(orderForm);
      const cart = window.AuraCart.getCart();

      const isSelf = formData.get('recipientIsMe') === 'on';
      const fulfillment = formData.get('fulfillment') === 'pickup' ? 'pickup' : 'delivery';
      const payload = {
        locale,
        items: cart.map((i) => ({ id: i.id, qty: i.qty })),
        buyerName: formData.get('buyerName'),
        buyerPhone: formData.get('buyerPhone'),
        buyerEmail: formData.get('buyerEmail'),
        recipientName: isSelf ? '' : formData.get('recipientName'),
        recipientPhone: isSelf ? '' : formData.get('recipientPhone'),
        fulfillment,
        address: fulfillment === 'delivery' ? formData.get('recipientAddress') : '',
        date: formData.get('date'),
        time: formData.get('time'),
        payment: formData.get('payment') === 'cash' ? 'cash' : 'online',
        comment: formData.get('comment') || '',
        acceptRegulamin: formData.get('acceptRegulamin') === 'on',
      };

      submitBtn.disabled = true;
      submitBtn.textContent = sendingLabel;
      statusMsg.textContent = '';
      statusMsg.className = 'order-status-msg';

      try {
        const res = await fetch('/api/order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => null);
        if (!res.ok || !data || !data.ok) throw new Error((data && data.error) || 'order-failed');

        if (data.mode === 'online' && data.redirectUrl) {
          // Корзину очищаем только после подтверждённой оплаты (страница «Спасибо»)
          statusMsg.textContent = redirectingMsg;
          statusMsg.className = 'order-status-msg success';
          window.location.href = data.redirectUrl;
          return;
        }

        statusMsg.textContent = successMsg;
        statusMsg.className = 'order-status-msg success';
        window.AuraCart.clearCart();
        orderForm.reset();
        submitBtn.disabled = false;
        submitBtn.textContent = submitLabel;
      } catch (err) {
        statusMsg.textContent = errorMsg;
        statusMsg.className = 'order-status-msg error';
        submitBtn.disabled = false;
        submitBtn.textContent = submitLabel;
      }
    });
  }
</script>