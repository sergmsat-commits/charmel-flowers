---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getProducts, photoAlt, PRODUCT_TEXT, type Locale } from '../data/products';

const currentLocale = (Astro.currentLocale ?? 'pl') as Locale;
const pt = PRODUCT_TEXT[currentLocale];
// «Показывать на главной»; «нет в наличии» на главной не показываем
const featured = (await getProducts()).filter((p) => p.featured && p.availability !== 'out-of-stock');

const labels = {
  pl: { title: 'Polecane', currency: 'zł', from: (p) => `od ${p} zł` },
  ru: { title: 'Рекомендуем', currency: 'zł', from: (p) => `от ${p} zł` },
  en: { title: 'Recommended', currency: 'zł', from: (p) => `from ${p} zł` },
};
const t = labels[currentLocale] ?? labels.pl;

const featuredWithPrice = featured.map((product) => {
  const lowestPrice = product.minPrice;
  const hasMultipleVariants = product.variants.length > 1;
  const productUrl = getRelativeLocaleUrl(currentLocale, `/product/${product.id}`);
  const priceText = product.priceOnRequest
    ? pt.priceOnRequest
    : hasMultipleVariants
      ? t.from(lowestPrice)
      : `${lowestPrice} ${t.currency}`;
  return { product, priceText, productUrl };
});
---

{featuredWithPrice.length > 0 && (
  <section class="featured-strip">
    <h2 class="featured-strip-title">{t.title}</h2>
    <div class="featured-track-wrapper">
      <div class="featured-track">
        {featuredWithPrice.map(({ product, priceText, productUrl }) => (
          <a href={productUrl} class="featured-mini-card">
            <Image src={product.photos[0]} format="webp" width={Math.min(360, product.photos[0].width)} alt={photoAlt(product, currentLocale, 0)} />
            <p class="featured-mini-title">{product.title[currentLocale]}</p>
            <p class="featured-mini-price">{priceText}</p>
          </a>
        ))}
        {featuredWithPrice.map(({ product, priceText, productUrl }) => (
          <a href={productUrl} class="featured-mini-card" aria-hidden="true" tabindex="-1">
            <Image src={product.photos[0]} format="webp" width={Math.min(360, product.photos[0].width)} alt="" />
            <p class="featured-mini-title">{product.title[currentLocale]}</p>
            <p class="featured-mini-price">{priceText}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
)}