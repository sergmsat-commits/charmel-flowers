---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { minPrice } from '../data/pricing';

const currentLocale = Astro.currentLocale ?? 'pl';
const allProducts = await getCollection('products');
const featured = allProducts.filter((p) => p.data.featured);

const labels = {
  pl: { title: 'Polecane', currency: 'zł', from: (p) => `od ${p} zł` },
  ru: { title: 'Рекомендуем', currency: 'zł', from: (p) => `от ${p} zł` },
  en: { title: 'Recommended', currency: 'zł', from: (p) => `from ${p} zł` },
};
const t = labels[currentLocale] ?? labels.pl;

const featuredWithPrice = featured.map((product) => {
  const prices = product.data.variants.map((v) => v.price);
  const lowestPrice = minPrice(prices);
  const hasMultipleVariants = product.data.variants.length > 1;
  const productUrl = getRelativeLocaleUrl(currentLocale, `/product/${product.id}`);
  return { product, lowestPrice, hasMultipleVariants, productUrl };
});
---

{featuredWithPrice.length > 0 && (
  <section class="featured-strip">
    <h2 class="featured-strip-title">{t.title}</h2>
    <div class="featured-track-wrapper">
      <div class="featured-track">
        {featuredWithPrice.map(({ product, lowestPrice, hasMultipleVariants, productUrl }) => (
          <a href={productUrl} class="featured-mini-card">
            <img src={`/images/products/${product.data.cover}`} alt={product.data.title[currentLocale]} />
            <p class="featured-mini-title">{product.data.title[currentLocale]}</p>
            <p class="featured-mini-price">{hasMultipleVariants ? t.from(lowestPrice) : `${lowestPrice} ${t.currency}`}</p>
          </a>
        ))}
        {featuredWithPrice.map(({ product, lowestPrice, hasMultipleVariants, productUrl }) => (
          <a href={productUrl} class="featured-mini-card" aria-hidden="true">
            <img src={`/images/products/${product.data.cover}`} alt={product.data.title[currentLocale]} />
            <p class="featured-mini-title">{product.data.title[currentLocale]}</p>
            <p class="featured-mini-price">{hasMultipleVariants ? t.from(lowestPrice) : `${lowestPrice} ${t.currency}`}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
)}