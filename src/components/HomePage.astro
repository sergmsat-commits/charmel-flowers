---
import AboutUs from './AboutUs.astro';
import Reviews from './Reviews.astro';
import LocationMap from './LocationMap.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

const currentLocale = Astro.currentLocale ?? 'pl';

const hero = {
  pl: {
    subtitle: 'Dobierzemy idealny bukiet dla Ciebie',
    delivery: '⚡ Bukiet gotowy w 15 minut',
    cta: 'Zobacz katalog',
  },
  ru: {
    subtitle: 'Подберём идеальный букет для тебя',
    delivery: '⚡ Букет готов за 15 минут',
    cta: 'Смотреть каталог',
  },
  en: {
    subtitle: "We'll find the perfect bouquet for you",
    delivery: '⚡ Bouquet ready in 15 minutes',
    cta: 'View Catalog',
  },
};
const t = hero[currentLocale] ?? hero.pl;
---

<section class="hero-section">
  <div class="hero-text">
    <h1>Charmel Flowers | Kwiaciarnia Warszawa</h1>
    <p class="hero-subtitle">{t.subtitle}</p>
    <p class="hero-delivery">{t.delivery}</p>
    <a href={getRelativeLocaleUrl(currentLocale, '/catalog')} class="hero-cta">{t.cta}</a>
  </div>
  <div class="hero-image">
    <img
      src="/images/products/bouquet-05.jpg"
      alt="Charmel Flowers"
      class="lightbox-trigger"
      data-images="/images/products/bouquet-05.jpg"
    />
  </div>
</section>

<AboutUs />
<Reviews />
<LocationMap />