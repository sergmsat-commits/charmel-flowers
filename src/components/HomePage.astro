---
import AboutUs from './AboutUs.astro';
import Reviews from './Reviews.astro';
import LocationMap from './LocationMap.astro';
import PromoSlider from './PromoSlider.astro';
import FeaturedStrip from './FeaturedStrip.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

const currentLocale = Astro.currentLocale ?? 'pl';

const hero = {
  pl: {
    subtitle: 'Dobierzemy idealny bukiet dla Ciebie',
    delivery: '⚡ Bukiet gotowy w 15 minut*',
    cta: 'Zobacz katalog',
  },
  ru: {
    subtitle: 'Подберём идеальный букет для тебя',
    delivery: '⚡ Букет готов за 15 минут*',
    cta: 'Смотреть каталог',
  },
  en: {
    subtitle: "We'll find the perfect bouquet for you",
    delivery: '⚡ Bouquet ready in 15 minutes*',
    cta: 'View Catalog',
  },
};
const t = hero[currentLocale] ?? hero.pl;
---

<section class="hero-section">
  <div class="hero-media">
    <img
      src="/images/products/bouquet-05.jpg"
      alt="Charmel Flowers"
      class="hero-media-img lightbox-trigger"
      data-images="/images/products/bouquet-05.jpg"
    />
    <div class="hero-scrim"></div>
  </div>

  <div class="hero-text">
    <h1>Charmel Flowers | Kwiaciarnia Warszawa</h1>
    <p class="hero-subtitle">{t.subtitle}</p>
    <p class="hero-delivery">{t.delivery}</p>
    <a href={getRelativeLocaleUrl(currentLocale, '/catalog')} class="hero-cta">{t.cta}</a>
  </div>
</section>

<PromoSlider />
<FeaturedStrip />
<AboutUs />
<Reviews />
<LocationMap />

<style>
  :global(body) {
    overflow-x: hidden;
  }

  .hero-section {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-top: -32px;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
    cursor: zoom-in;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(24, 16, 12, 0.6) 0%,
      rgba(24, 16, 12, 0.4) 32%,
      rgba(24, 16, 12, 0.12) 62%,
      rgba(24, 16, 12, 0) 85%
    );
  }

  .hero-text {
    position: relative;
    z-index: 1;
    max-width: 620px;
    width: 100%;
    padding: 100px clamp(20px, 6vw, 80px);
  }

  .hero-text h1 {
    font-family: var(--font-heading);
    color: #fff;
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.15;
    margin-bottom: 16px;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.35);
  }

  .hero-subtitle {
    font-family: var(--font-body);
    color: rgba(255, 255, 255, 0.92);
    font-size: 1.1rem;
    margin-bottom: 18px;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
  }

  .hero-delivery {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    color: #F5C16C;
    font-weight: 700;
    font-size: 1.05rem;
    margin-bottom: 32px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }

  .hero-cta {
    display: inline-block;
    font-family: var(--font-body);
    background: var(--color-accent);
    color: var(--color-white);
    padding: 16px 32px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hero-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 860px) {
    .hero-section {
      min-height: 92svh;
      align-items: flex-end;
    }

    .hero-scrim {
      background: linear-gradient(
        180deg,
        rgba(24, 16, 12, 0.15) 0%,
        rgba(24, 16, 12, 0.55) 55%,
        rgba(24, 16, 12, 0.85) 100%
      );
    }

    .hero-text {
      max-width: 100%;
      padding: 24px 20px 56px;
    }
  }
</style>