      },
      {
        q: 'How do I care for the flowers?',
        a: 'Trim the stems at an angle before placing them in water, change the water every 2 days, keep the bouquet away from direct sunlight and radiators, and remove wilted petals and leaves promptly — this will make the flowers last much longer.',
      },
      {
        q: 'Do you have a physical flower shop in Warsaw?',
        a: "Yes! Charmel Flowers has a studio in Warsaw — at Stryjeńskich 6/lok.UH1B, Kabaty. You're always welcome to visit us in person, see the fresh flowers and get help from our florists in choosing the perfect bouquet.",
      },
      {
        q: 'Can I add a card or get a photo of the bouquet before delivery?',
        a: "Yes — you can request a card in the order comment field. If you'd like a photo of the finished bouquet before delivery, mention it in the comment or on WhatsApp and we'll do our best to send one.",
      },
      {
        q: 'Why do customers choose Charmel Flowers?',
        a: 'Charmel Flowers is one of the highest-rated flower shops in Warsaw, with years of experience in floristry. Customers value us for fresh flowers, stylish arrangements, fast delivery and professional service. Our floral studio has a rating of around 4.9 on Google Maps. We care about every bouquet making an impression — from flower selection to packaging.',
      },
    ],
  },
};

const t = content[currentLocale] ?? content.pl;
const mapLat = 52.1329367;
const mapLng = 21.0575091;
const googleReviewUrl = 'https://search.google.com/local/writereview?placeid=ChIJpZguVQktGUcRgcZuk78afvE';
const whatsappReviewUrl = `https://wa.me/48514011410?text=${encodeURIComponent(t.whatsappText)}`;
---

<section class="location-section reveal">
  <h2>{t.title}</h2>
  <p class="location-address">{t.address}</p>
  <p class="location-phone">{t.phoneLabel}: <a href="tel:+48514011410">+48 514 011 410</a></p>

  <div class="location-hours">
    <h3>{t.hoursTitle}</h3>
    {t.hours.map((row) => (
      <p class="location-hours-row">
        <span>{row.days}</span>
        <span>{row.time}</span>
      </p>
    ))}
  </div>

  <div class="faq-section">
    <h2>{t.faqTitle}</h2>
    <div class="faq-list">
      {t.faq.map((item, i) => (
        <div class="faq-item" data-faq-item>
          <button class="faq-question" aria-expanded="false">
            <span>{item.q}</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">
              <p>{item.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="map-embed">
    <iframe
      src={`https://www.google.com/maps?q=${mapLat},${mapLng}&output=embed`}
      width="100%"
      height="400"
      style="border:0;"
      allowfullscreen
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Charmel Flowers — location map"
    ></iframe>
  </div>

  <div class="review-cta">
    <p class="review-cta-rating">{t.ratingText}</p>
    <a href={googleReviewUrl} target="_blank" rel="noopener" class="review-cta-primary">{t.reviewPrimary}</a>
    <a href={whatsappReviewUrl} target="_blank" rel="noopener" class="review-cta-secondary">{t.reviewSecondary}</a>
  </div>
</section>

<script>
  document.querySelectorAll('.faq-question').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('[data-faq-item]');
      const isOpen = item.classList.contains('is-open');
      document.querySelectorAll('[data-faq-item].is-open').forEach((openItem) => {
        if (openItem !== item) {
          openItem.classList.remove('is-open');
          openItem.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
        }
      });
      item.classList.toggle('is-open', !isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  });
</script>