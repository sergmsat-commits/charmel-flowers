---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { SECTIONS } from '../data/sections';

const currentLocale = Astro.currentLocale ?? 'pl';
const catalogUrl = getRelativeLocaleUrl(currentLocale, '/catalog');
---

<section class="category-tiles" aria-label="Catalog sections">
  {SECTIONS.map((s) => (
    <a href={`${catalogUrl}?section=${s.slug}`} class={`category-tile${s.image ? '' : ' category-tile--noimg'}`}>
      {s.image && <img src={`/images/sections/${s.image}`} alt="" loading="lazy" />}
      <span class="category-tile-shade"></span>
      <span class="category-tile-label">{s[currentLocale] ?? s.ru}</span>
    </a>
  ))}
</section>

<style>
  /* Блок растянут на всю ширину экрана (как главный экран), по 2 карточки в ряд */
  .category-tiles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    width: 100vw;
    /* отступ сверху = отступу между главным экраном и бегущей строкой (40px) */
    margin: 40px calc(50% - 50vw);
    padding: 0;
  }

  .category-tile {
    position: relative;
    display: block;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: linear-gradient(135deg, var(--color-primary, #E8DCC7), var(--color-primary-dark, #C9B48F));
    text-decoration: none;
  }

  .category-tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  /* лёгкое затемнение всегда (чтобы читалась надпись), сильнее — при наведении */
  .category-tile-shade {
    position: absolute;
    inset: 0;
    background: rgba(24, 16, 12, 0.18);
    transition: background 0.3s ease;
  }

  .category-tile:hover .category-tile-shade,
  .category-tile:focus-visible .category-tile-shade {
    background: rgba(24, 16, 12, 0.42);
  }

  .category-tile:hover img { transform: scale(1.04); }

  .category-tile:focus-visible {
    outline: 3px solid var(--color-accent, #6B4423);
    outline-offset: 3px;
  }

  .category-tile-label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    text-align: center;
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 2.6vw, 1.9rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
  }

  .category-tile--noimg .category-tile-label {
    color: var(--color-accent, #6B4423);
    text-shadow: none;
  }

  /* Телефоны: по одной карточке в ряд */
  @media (max-width: 600px) {
    .category-tiles { grid-template-columns: 1fr; gap: 6px; margin-top: 28px; margin-bottom: 28px; }
    .category-tile { aspect-ratio: 16 / 9; }
    .category-tile-label { font-size: 1.2rem; letter-spacing: 0.06em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-tile img, .category-tile-shade { transition: none; }
  }
</style>