---
const currentLocale = Astro.currentLocale ?? 'pl';

const content = {
  pl: {
    title: 'O nas',
    paragraphs: [
      'Charmel Flowers to kwiaciarnia w Warszawie, tworząca bukiety i kompozycje w eleganckim, stonowanym stylu.',
      'Od świeżych bukietów po ręcznie robione świece i kwiaty doniczkowe w autorskich pudełkach — każdy detal ma znaczenie.',
      'Bukiet gotowy w 15 minut, dostawa przez Uber lub Wolt — szybko i wygodnie, bez zbędnych formalności.',
    ],
  },
  ru: {
    title: 'О нас',
    paragraphs: [
      'Charmel Flowers — цветочный магазин в Варшаве, создающий букеты и композиции в элегантном, сдержанном стиле.',
      'От свежих букетов до свечей ручной работы и цветов в горшках в фирменных коробках — каждая деталь имеет значение.',
      'Букет готов за 15 минут, доставка через Uber или Wolt — быстро и удобно, без лишних формальностей.',
    ],
  },
  en: {
    title: 'About Us',
    paragraphs: [
      'Charmel Flowers is a Warsaw flower shop creating bouquets and arrangements in an elegant, understated style.',
      'From fresh bouquets to handmade candles and potted plants in branded boxes — every detail matters.',
      'Bouquets ready in 15 minutes, delivered via Uber or Wolt — fast and convenient, without unnecessary hassle.',
    ],
  },
};

const t = content[currentLocale] ?? content.pl;
---

<section class="about-section reveal">
  <h2>{t.title}</h2>
  {t.paragraphs.map((p) => <p>{p}</p>)}
</section>