---
import { getCollection } from 'astro:content';

const currentLocale = Astro.currentLocale ?? 'pl';
const products = await getCollection('products');

const ranges = ['100-200', '200-400', '400-600', '600-800', '1000+'];

const labels = {
  pl: { all: 'Wszystkie', wedding: 'Ślub', promo: 'Akcja', handmade: 'Rękodzieło', featured: 'Polecane', currency: 'zł', addToCart: 'Do koszyka' },
  ru: { all: 'Все', wedding: 'Свадьба', promo: 'Акция', handmade: 'Ручная работа', featured: 'Рекомендуем', currency: 'zł', addToCart: 'В корзину' },
  en: { all: 'All', wedding: 'Wedding', promo: 'Promo', handmade: 'Handmade', featured: 'Featured', currency: 'zł', addToCart: 'Add to cart' },
};
const t = labels[currentLocale] ?? labels.pl;
---

<div class="catalog-wrapper">
  <div class="filter-row">
    <button class="filter-btn active" data-filter-group="price" data-value="all">{t.all}</button>
    {ranges.map((r) => (
      <button class="filter-btn" data-filter-group="price" data-value={r}>{r}</button>
    ))}
  </div>

  <div class="filter-row">
    <button class="filter-btn active" data-filter-group="category" data-value="all">{t.all}</button>
    <button class="filter-btn" data-filter-group="category" data-value="wedding">{t.wedding}</button>
    <button class="filter-btn" data-filter-group="category" data-value="promo">{t.promo}</button>
    <button class="filter-btn" data-filter-group="category" data-value="handmade">{t.handmade}</button>
  </div>

  <div class="catalog-grid">
    {products.map((product, index) => (
      <div
        class="product-card reveal"
        style={`transition-delay: ${Math.min(index * 60, 300)}ms`}
        data-price-range={product.data.priceRange}
        data-wedding={product.data.wedding ? 'true' : 'false'}
        data-promo={product.data.promo ? 'true' : 'false'}
        data-handmade={product.data.handmade ? 'true' : 'false'}
      >
        {product.data.featured && <span class="product-badge">{t.featured}</span>}
        <img src={`/images/products/${product.data.cover}`} alt={product.data.title[currentLocale]} class="product-img" />
        <h3 class="product-title">{product.data.title[currentLocale]}</h3>
        <p class="product-description">{product.data.description[currentLocale]}</p>
        <p class="product-price">{product.data.price} {t.currency}</p>
        <button
          class="add-to-cart-btn"
          data-id={product.id}
          data-title={product.data.title[currentLocale]}
          data-price={product.data.price}
          data-cover={product.data.cover}
        >
          {t.addToCart}
        </button>
      </div>
    ))}
  </div>
</div>

<script>
  const priceButtons = document.querySelectorAll('.filter-btn[data-filter-group="price"]');
  const categoryButtons = document.querySelectorAll('.filter-btn[data-filter-group="category"]');
  const cards = document.querySelectorAll('.product-card');

  let selectedPrice = 'all';
  let selectedCategory = 'all';

  function applyFilters() {
    cards.forEach((card) => {
      const priceMatch = selectedPrice === 'all' || card.getAttribute('data-price-range') === selectedPrice;
      const categoryMatch =
        selectedCategory === 'all' ||
        card.getAttribute(`data-${selectedCategory}`) === 'true';
      card.style.display = priceMatch && categoryMatch ? '' : 'none';
    });
  }

  priceButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      priceButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      selectedPrice = btn.getAttribute('data-value');
      applyFilters();
    });
  });

  categoryButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      categoryButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      selectedCategory = btn.getAttribute('data-value');
      applyFilters();
    });
  });

  document.querySelectorAll('.add-to-cart-btn').forEach((btn) => {
    const originalText = btn.textContent;
    btn.addEventListener('click', () => {
      if (!window.AuraCart) return;
      window.AuraCart.addItem({
        id: btn.getAttribute('data-id'),
        title: btn.getAttribute('data-title'),
        price: Number(btn.getAttribute('data-price')),
        cover: btn.getAttribute('data-cover'),
      });
      btn.textContent = '✓';
      setTimeout(() => {
        btn.textContent = originalText;
      }, 1000);
    });
  });
</script>