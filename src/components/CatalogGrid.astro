---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { FLOWER_SPECIES } from '../data/flowerSpecies';
import { productPriceBuckets } from '../data/pricing';
import { SECTIONS } from '../data/sections';
import {
  getProducts,
  paragraphs,
  photoAlt,
  photoUrl,
  absoluteUrl,
  variantCartId,
  whatsappUrl,
  PRODUCT_TEXT,
  type Locale,
} from '../data/products';

const currentLocale = (Astro.currentLocale ?? 'pl') as Locale;
const pt = PRODUCT_TEXT[currentLocale];
const products = await getProducts();
// обложка для избранного и корзины (WebP 400 px)
const cards = await Promise.all(products.map(async (product) => ({ product, cover400: await photoUrl(product.photos[0], 400) })));

const ranges = ['100-200', '200-400', '400-600', '600-800', '1000+'];
const sizes = ['S', 'M', 'L', 'XL', 'XXL'];
const initialVisibleSpeciesCount = 5;

const labels = {
  pl: {
    all: 'Wszystkie', wedding: 'Ślub', promo: 'Akcja', handmade: 'Rękodzieło', featured: 'Polecane', currency: 'zł', addToCart: 'Do koszyka',
    emptySection: 'Wkrótce dodamy tutaj nowe bukiety.',
    compositionTitle: 'Skład bukietu:', sizeTitle: 'Rozmiar:', reset: 'wyczyść',
    showMore: (n) => `pokaż jeszcze ${n}`, showLess: 'ukryj',
    from: (p) => `od ${p} zł`, chooseSize: 'Wybierz rozmiar',
    descMore: 'Zobacz więcej', descLess: 'Zwiń',
  },
  ru: {
    all: 'Все', wedding: 'Свадьба', promo: 'Акция', handmade: 'Ручная работа', featured: 'Рекомендуем', currency: 'zł', addToCart: 'В корзину',
    emptySection: 'Скоро здесь появятся новые букеты.',
    compositionTitle: 'Состав букета:', sizeTitle: 'Размер:', reset: 'сбросить',
    showMore: (n) => `показать ещё ${n}`, showLess: 'скрыть',
    from: (p) => `от ${p} zł`, chooseSize: 'Выбрать размер',
    descMore: 'Смотреть полностью', descLess: 'Свернуть',
  },
  en: {
    all: 'All', wedding: 'Wedding', promo: 'Promo', handmade: 'Handmade', featured: 'Featured', currency: 'zł', addToCart: 'Add to cart',
    emptySection: 'New bouquets are coming here soon.',
    compositionTitle: 'Composition:', sizeTitle: 'Size:', reset: 'clear',
    showMore: (n) => `show ${n} more`, showLess: 'hide',
    from: (p) => `from ${p} zł`, chooseSize: 'Choose size',
    descMore: 'Show more', descLess: 'Show less',
  },
};
const t = labels[currentLocale] ?? labels.pl;
---

<div class="catalog-wrapper">
  <div class="filter-row">
    <button class="filter-btn active" data-filter-group="price" data-value="all">{t.all}</button>
    {ranges.map((r) => (
      <button class="filter-btn" data-filter-group="price" data-value={r}>{r}</button>
    ))}
  </div>

  <div class="filter-row">
    <button class="filter-btn active" data-filter-group="section" data-value="all">{t.all}</button>
    {SECTIONS.map((s) => (
      <button class="filter-btn" data-filter-group="section" data-value={s.slug}>{s[currentLocale] ?? s.ru}</button>
    ))}
  </div>

  <div class="filter-row">
    <button class="filter-btn active" data-filter-group="category" data-value="all">{t.all}</button>
    <button class="filter-btn" data-filter-group="category" data-value="wedding">{t.wedding}</button>
    <button class="filter-btn" data-filter-group="category" data-value="promo">{t.promo}</button>
    <button class="filter-btn" data-filter-group="category" data-value="handmade">{t.handmade}</button>
  </div>

  <div class="catalog-layout">
    <aside class="catalog-sidebar">
      <div class="sidebar-filter-group">
        <div class="sidebar-filter-header">
          <span>{t.compositionTitle}</span>
          <button type="button" class="sidebar-reset-btn" data-reset="composition">{t.reset}</button>
        </div>
        <div class="composition-list">
          {FLOWER_SPECIES.map((species, i) => (
            <label class={`composition-item${i >= initialVisibleSpeciesCount ? ' composition-item-extra' : ''}`} style={i >= initialVisibleSpeciesCount ? 'display:none;' : undefined}>
              <input type="checkbox" class="composition-checkbox" data-species={species.slug} />
              <span class="composition-label">{species[currentLocale] ?? species.ru}</span>
            </label>
          ))}
        </div>
        {FLOWER_SPECIES.length > initialVisibleSpeciesCount && (
          <button
            type="button"
            class="composition-toggle-btn"
            id="composition-toggle-btn"
            data-show-more={t.showMore(FLOWER_SPECIES.length - initialVisibleSpeciesCount)}
            data-show-less={t.showLess}
          >
            {t.showMore(FLOWER_SPECIES.length - initialVisibleSpeciesCount)}
          </button>
        )}
      </div>

      <div class="sidebar-filter-group">
        <div class="sidebar-filter-header">
          <span>{t.sizeTitle}</span>
          <button type="button" class="sidebar-reset-btn" data-reset="size">{t.reset}</button>
        </div>
        <div class="size-list">
          {sizes.map((s) => (
            <label class="size-item">
              <input type="checkbox" class="size-checkbox" data-size={s} />
              <span class="size-label">{s}</span>
            </label>
          ))}
        </div>
      </div>
    </aside>

    <div class="catalog-grid">
      {cards.map(({ product, cover400 }, index) => {
        const prices = product.variants.map((v) => v.price);
        const priceBuckets = productPriceBuckets(prices).join(' ');
        const productSizes = product.variants.map((v) => v.size).filter(Boolean).join(' ');
        const lowestPrice = product.minPrice;
        const hasMultipleVariants = product.variants.length > 1;
        const single = product.variants[0];
        const productUrl = getRelativeLocaleUrl(currentLocale, `/product/${product.id}`);
        const title = product.title[currentLocale];
        const descriptionParagraphs = paragraphs(product.description[currentLocale]);
        const descriptionIntro = descriptionParagraphs[0] ? (descriptionParagraphs[0].label ? `${descriptionParagraphs[0].label}: ${descriptionParagraphs[0].text}` : descriptionParagraphs[0].text) : '';
        const badge =
          product.availability === 'out-of-stock'
            ? { text: pt.outOfStock, cls: 'product-badge product-badge--out' }
            : product.hasOldPrice
              ? { text: pt.promo, cls: 'product-badge product-badge--promo' }
              : product.availability === 'made-to-order'
                ? { text: pt.madeToOrder, cls: 'product-badge product-badge--order' }
                : product.featured
                  ? { text: t.featured, cls: 'product-badge' }
                  : null;

        return (
          <div
            class={`product-card reveal${product.availability === 'out-of-stock' ? ' product-card--out' : ''}`}
            style={`transition-delay: ${Math.min(index * 60, 300)}ms`}
            data-price-ranges={priceBuckets}
            data-wedding={product.wedding ? 'true' : 'false'}
            data-promo={product.promo ? 'true' : 'false'}
            data-handmade={product.handmade ? 'true' : 'false'}
            data-sections={product.sections.join(' ')}
            data-size={productSizes}
            data-composition={product.composition.join(',')}
          >
            {badge && <span class={badge.cls}>{badge.text}</span>}
            <button
              class="favorite-btn"
              data-favorite-id={product.id}
              data-favorite-title={title}
              data-favorite-price={lowestPrice ?? ''}
              data-favorite-cover={cover400}
              aria-label="Favorite"
            >♥</button>
            <a href={productUrl} class="product-image-link">
              <Image
                src={product.photos[0]}
                format="webp"
                widths={[400, 800].filter((w) => w <= product.photos[0].width).concat(product.photos[0].width < 400 ? [product.photos[0].width] : [])}
                sizes="(max-width: 480px) 100vw, 320px"
                alt={photoAlt(product, currentLocale, 0)}
                class="product-img"
                loading={index < 3 ? 'eager' : 'lazy'}
              />
            </a>
            <a href={productUrl} class="product-title-link">
              <h3 class="product-title">{title}</h3>
            </a>
            {descriptionParagraphs.length > 0 && (
            <div class="product-description-wrap">
              <p class="product-description product-description-preview">{descriptionIntro}</p>
              <div class="product-description-full">
                {descriptionParagraphs.map((p) => (
                  <p>
                    {p.label && <strong>{p.label}: </strong>}
                    {p.text}
                  </p>
                ))}
              </div>
              <button
                type="button"
                class="description-toggle-btn"
                data-show-more={t.descMore}
                data-show-less={t.descLess}
              >
                {t.descMore}
              </button>
            </div>
            )}
            <p class="product-price">
              {product.priceOnRequest
                ? pt.priceOnRequest
                : hasMultipleVariants
                  ? t.from(lowestPrice)
                  : (
                    <>
                      {single.oldPrice && <s class="product-old-price">{single.oldPrice} {t.currency}</s>}
                      {`${lowestPrice} ${t.currency}`}
                    </>
                  )}
            </p>
            {!product.purchasable ? (
              <a href={whatsappUrl(product, currentLocale, absoluteUrl(productUrl))} target="_blank" rel="noopener" class="add-to-cart-btn ask-whatsapp-btn">{pt.askWhatsApp}</a>
            ) : hasMultipleVariants ? (
              <a href={productUrl} class="add-to-cart-btn">{t.chooseSize}</a>
            ) : (
              <button
                class="add-to-cart-btn"
                data-id={variantCartId(product, single)}
                data-title={title}
                data-price={single.price}
                data-cover={cover400}
              >
                {t.addToCart}
              </button>
            )}
          </div>
        );
      })}
      <p class="catalog-empty" id="catalog-empty" hidden>{t.emptySection}</p>
    </div>
  </div>
</div>

<style>
  .catalog-empty {
    grid-column: 1 / -1;
    padding: 48px 16px;
    text-align: center;
    font-family: var(--font-heading);
    color: var(--color-accent);
    font-size: 1.1rem;
  }

  .catalog-layout {
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }

  .catalog-sidebar {
    flex: 0 0 220px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .catalog-layout .catalog-grid {
    flex: 1;
    min-width: 0;
  }

  .sidebar-filter-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .sidebar-filter-header span {
    font-family: var(--font-heading);
    font-weight: bold;
    color: var(--color-text);
    font-size: 0.95rem;
  }

  .sidebar-reset-btn {
    background: none;
    border: none;
    color: var(--color-accent);
    font-size: 0.8rem;
    cursor: pointer;
    text-decoration: underline;
    padding: 0;
  }

  .composition-list,
  .size-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .composition-item,
  .size-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-text);
    cursor: pointer;
  }

  .composition-item.is-unavailable,
  .size-item.is-unavailable {
    color: #aaa;
    text-decoration: line-through;
    cursor: default;
  }

  .composition-toggle-btn {
    margin-top: 10px;
    background: none;
    border: none;
    color: var(--color-accent);
    font-size: 0.85rem;
    text-decoration: underline dotted;
    cursor: pointer;
    padding: 0;
  }

  a.add-to-cart-btn {
    display: inline-block;
    text-align: center;
    text-decoration: none;
  }

  .product-description-wrap {
    padding: 0 16px 4px;
  }

  .product-description-preview {
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-description-full {
    display: none;
  }

  .product-description-full p {
    font-size: 0.85rem;
    color: #666;
    margin-bottom: 8px;
    line-height: 1.5;
  }

  .product-description-full p strong {
    color: var(--color-accent);
  }

  .product-old-price {
    color: #999;
    font-weight: normal;
    font-size: 0.85em;
    margin-right: 6px;
  }

  .product-badge--promo {
    background-color: #b5523b;
  }

  .product-badge--order {
    background-color: var(--color-accent);
  }

  .product-badge--out {
    background-color: #777;
  }

  .product-card--out .product-img {
    opacity: 0.6;
  }

  a.ask-whatsapp-btn {
    background-color: #25d366;
  }

  .description-toggle-btn {
    background: none;
    border: none;
    color: var(--color-accent);
    font-size: 0.8rem;
    text-decoration: underline;
    cursor: pointer;
    padding: 0 0 8px;
  }

  @media (max-width: 480px) {
    .catalog-layout {
      flex-direction: column;
    }

    .catalog-sidebar {
      flex: 1 1 auto;
      width: 100%;
    }
  }
</style>

<script>
  const priceButtons = document.querySelectorAll('.filter-btn[data-filter-group="price"]');
  const categoryButtons = document.querySelectorAll('.filter-btn[data-filter-group="category"]');
  const sectionButtons = document.querySelectorAll('.filter-btn[data-filter-group="section"]');
  const emptyMsg = document.getElementById('catalog-empty');
  const sizeCheckboxes = document.querySelectorAll('.size-checkbox');
  const compositionCheckboxes = document.querySelectorAll('.composition-checkbox');
  const cards = document.querySelectorAll('.product-card');

  let selectedPrice = 'all';
  let selectedCategory = 'all';
  let selectedSection = 'all';

  function getSelectedSizes() {
    return Array.from(sizeCheckboxes)
      .filter((cb) => cb.checked)
      .map((cb) => cb.getAttribute('data-size'));
  }

  function getSelectedComposition() {
    return Array.from(compositionCheckboxes)
      .filter((cb) => cb.checked)
      .map((cb) => cb.getAttribute('data-species'));
  }

  function cardSizeList(card) {
    return (card.getAttribute('data-size') || '').split(' ').filter(Boolean);
  }

  function cardMatchesSize(card, sizes) {
    if (sizes.length === 0) return true;
    const cardSizes = cardSizeList(card);
    return sizes.some((s) => cardSizes.includes(s));
  }

  function cardMatchesComposition(card, species) {
    if (species.length === 0) return true;
    const cardSpecies = (card.getAttribute('data-composition') || '').split(',').filter(Boolean);
    return species.some((s) => cardSpecies.includes(s));
  }

  function cardMatchesPrice(card, price) {
    if (price === 'all') return true;
    const cardRanges = (card.getAttribute('data-price-ranges') || '').split(' ').filter(Boolean);
    return cardRanges.includes(price);
  }

  function filterCards() {
    const selectedSizes = getSelectedSizes();
    const selectedComposition = getSelectedComposition();
    let visibleCount = 0;

    cards.forEach((card) => {
      const priceMatch = cardMatchesPrice(card, selectedPrice);
      const categoryMatch =
        selectedCategory === 'all' ||
        card.getAttribute(`data-${selectedCategory}`) === 'true';
      const sizeMatch = cardMatchesSize(card, selectedSizes);
      const compositionMatch = cardMatchesComposition(card, selectedComposition);
      const sectionMatch =
        selectedSection === 'all' ||
        (card.getAttribute('data-sections') || '').split(' ').includes(selectedSection);
      const visible = priceMatch && categoryMatch && sectionMatch && sizeMatch && compositionMatch;
      card.style.display = visible ? '' : 'none';
      if (visible) visibleCount += 1;
    });
    if (emptyMsg) emptyMsg.hidden = visibleCount > 0;
  }

  // Возвращает true, если пришлось принудительно снять галочку с недоступного варианта
  function updateFacetAvailability() {
    const selectedSizes = getSelectedSizes();
    const selectedComposition = getSelectedComposition();
    let forcedUncheck = false;

    // доступные размеры = размеры товаров, проходящих фильтр состава (без учёта самого размера)
    const availableSizes = new Set();
    cards.forEach((card) => {
      if (cardMatchesComposition(card, selectedComposition)) {
        cardSizeList(card).forEach((s) => availableSizes.add(s));
      }
    });
    sizeCheckboxes.forEach((cb) => {
      const label = cb.closest('.size-item');
      const isAvailable = availableSizes.has(cb.getAttribute('data-size'));
      if (label) label.classList.toggle('is-unavailable', !isAvailable);
      if (!isAvailable && cb.checked) {
        cb.checked = false;
        forcedUncheck = true;
      }
    });

    // доступные виды = виды товаров, проходящих фильтр размера (без учёта самого состава)
    const availableSpecies = new Set();
    cards.forEach((card) => {
      if (cardMatchesSize(card, selectedSizes)) {
        const cardSpecies = (card.getAttribute('data-composition') || '').split(',').filter(Boolean);
        cardSpecies.forEach((s) => availableSpecies.add(s));
      }
    });
    compositionCheckboxes.forEach((cb) => {
      const label = cb.closest('.composition-item');
      const isAvailable = availableSpecies.has(cb.getAttribute('data-species'));
      if (label) label.classList.toggle('is-unavailable', !isAvailable);
      if (!isAvailable && cb.checked) {
        cb.checked = false;
        forcedUncheck = true;
      }
    });

    return forcedUncheck;
  }

  function applyAllFilters() {
    filterCards();
    const hadForcedUncheck = updateFacetAvailability();
    if (hadForcedUncheck) {
      filterCards();
      updateFacetAvailability();
    }
  }

  priceButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      priceButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      selectedPrice = btn.getAttribute('data-value');
      applyAllFilters();
    });
  });

  categoryButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      categoryButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      selectedCategory = btn.getAttribute('data-value');
      applyAllFilters();
    });
  });

  sectionButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      setSection(btn.getAttribute('data-value'));
      applyAllFilters();
    });
  });

  function setSection(value) {
    sectionButtons.forEach((b) => b.classList.toggle('active', b.getAttribute('data-value') === value));
    selectedSection = value;
  }

  // переход с главной: /catalog?section=mono
  const sectionFromUrl = new URLSearchParams(window.location.search).get('section');
  if (sectionFromUrl && Array.from(sectionButtons).some((b) => b.getAttribute('data-value') === sectionFromUrl)) {
    setSection(sectionFromUrl);
    applyAllFilters();
  }

  sizeCheckboxes.forEach((cb) => cb.addEventListener('change', applyAllFilters));
  compositionCheckboxes.forEach((cb) => cb.addEventListener('change', applyAllFilters));

  document.querySelectorAll('.sidebar-reset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const group = btn.getAttribute('data-reset');
      const targets = group === 'size' ? sizeCheckboxes : compositionCheckboxes;
      targets.forEach((cb) => {
        cb.checked = false;
      });
      applyAllFilters();
    });
  });

  const compositionToggleBtn = document.getElementById('composition-toggle-btn');
  if (compositionToggleBtn) {
    compositionToggleBtn.addEventListener('click', () => {
      const extraItems = document.querySelectorAll('.composition-item-extra');
      const isHidden = extraItems.length > 0 && extraItems[0].style.display === 'none';
      extraItems.forEach((item) => {
        item.style.display = isHidden ? '' : 'none';
      });
      compositionToggleBtn.textContent = isHidden
        ? compositionToggleBtn.getAttribute('data-show-less')
        : compositionToggleBtn.getAttribute('data-show-more');
    });
  }

  // первичный расчёт доступности фасетов при загрузке страницы
  updateFacetAvailability();

  document.querySelectorAll('.add-to-cart-btn').forEach((btn) => {
    // Для товаров с несколькими вариантами это <a>, ведущая на страницу товара —
    // там нет data-id, и слушатель добавления в корзину ей не нужен.
    if (!btn.hasAttribute('data-id')) return;
    const originalText = btn.textContent;
    btn.addEventListener('click', () => {
      if (!window.AuraCart) return;
      window.AuraCart.addItem({
        id: btn.getAttribute('data-id'),
        title: btn.getAttribute('data-title'),
        price: Number(btn.getAttribute('data-price')),
        cover: btn.getAttribute('data-cover'),
      });
      btn.textContent = '✓';
      setTimeout(() => {
        btn.textContent = originalText;
      }, 1000);
    });
  });

  document.querySelectorAll('.description-toggle-btn').forEach((btn) => {
    const wrap = btn.closest('.product-description-wrap');
    if (!wrap) return;
    const preview = wrap.querySelector('.product-description-preview');
    const full = wrap.querySelector('.product-description-full');
    btn.addEventListener('click', () => {
      const isHidden = !full || full.style.display === 'none' || full.style.display === '';
      if (full) full.style.display = isHidden ? 'block' : 'none';
      if (preview) preview.style.display = isHidden ? 'none' : '';
      btn.textContent = isHidden
        ? btn.getAttribute('data-show-less')
        : btn.getAttribute('data-show-more');
    });
  });

  document.querySelectorAll('.favorite-btn').forEach((btn) => {
    const id = btn.getAttribute('data-favorite-id');
    if (window.CharmelFavorites && window.CharmelFavorites.isFavorite(id)) {
      btn.classList.add('is-active');
    }
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!window.CharmelFavorites) return;
      const item = {
        id,
        title: btn.getAttribute('data-favorite-title'),
        price: Number(btn.getAttribute('data-favorite-price')),
        cover: btn.getAttribute('data-favorite-cover'),
      };
      const nowActive = window.CharmelFavorites.toggleFavorite(item);
      btn.classList.toggle('is-active', nowActive);
    });
  });
</script>