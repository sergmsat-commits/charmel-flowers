---
import { getCollection } from 'astro:content';

const currentLocale = Astro.currentLocale ?? 'pl';
const products = await getCollection('products');

const ranges = ['100-200', '200-400', '400-600', '600-800', '1000+'];

const labels = {
  pl: { all: 'Wszystkie', wedding: 'Ślub', promo: 'Akcja', handmade: 'Rękodzieło', featured: 'Polecane', currency: 'zł', addToCart: 'Do koszyka' },
  ru: { all: 'Все', wedding: 'Свадьба', promo: 'Акция', handmade: 'Ручная работа', featured: 'Рекомендуем', currency: 'zł', addToCart: 'В корзину' },
  en: { all: 'All', wedding: 'Wedding', promo: 'Promo', handmade: 'Handmade', featured: 'Featured', currency: 'zł', addToCart: 'Add to cart' },
};
const t = labels[currentLocale] ?? labels.pl;
---

<div class="catalog-wrapper">
  <div class="filter-row">
    <button class="filter-btn active" data-filter-group="price" data-value="all">{t.all}</button>
    {ranges.map((r) => (
      <button class="filter-btn" data-filter-group="price" data-value={r}>{r}</button>
    ))}
  </div>

  <div class="filter-row">
    <button class="filter-btn active" data-filter-group="category" data-value="all">{t.all}</button>
    <button class="filter-btn" data-filter-group="category" data-value="wedding">{t.wedding}</button>
    <button class="filter-btn" data-filter-group="category" data-value="promo">{t.promo}</button>
    <button class="filter-btn" data-filter-group="category" data-value="handmade">{t.handmade}</button>
  </div>

  <div class="catalog-grid">
    {products.map((product, index) => {
      const allImages = [product.data.cover, ...product.data.gallery]
        .map((f) => `/images/products/${f}`)
        .join(',');
      return (
        <div
          class="product-card reveal"
          style={`transition-delay: ${Math.min(index * 60, 300)}ms`}
          data-price-range={product.data.priceRange}
          data-wedding={product.data.wedding ? 'true' : 'false'}
          data-promo={product.data.promo ? 'true' : 'false'}
          data-handmade={product.data.handmade ? 'true' : 'false'}
        >
          {product.data.featured && <span class="product-badge">{t.featured}</span>}
          <img
            src={`/images/products/${product.data.cover}`}
            alt={product.data.title[currentLocale]}
            class="product-img"
            data-images={allImages}
          />
          <h3 class="product-title">{product.data.title[currentLocale]}</h3>
          <p class="product-description">{product.data.description[currentLocale]}</p>
          <p class="product-price">{product.data.price} {t.currency}</p>
          <button
            class="add-to-cart-btn"
            data-id={product.id}
            data-title={product.data.title[currentLocale]}
            data-price={product.data.price}
            data-cover={product.data.cover}
          >
            {t.addToCart}
          </button>
        </div>
      );
    })}
  </div>
</div>

<div class="lightbox" id="product-lightbox" aria-hidden="true">
  <button class="lightbox-close" id="lightbox-close" aria-label="Close">&times;</button>
  <button class="lightbox-prev" id="lightbox-prev" aria-label="Previous">&#8249;</button>
  <img src="" alt="" class="lightbox-img" id="lightbox-img" />
  <button class="lightbox-next" id="lightbox-next" aria-label="Next">&#8250;</button>
  <p class="lightbox-counter" id="lightbox-counter"></p>
</div>

<script>
  const priceButtons = document.querySelectorAll('.filter-btn[data-filter-group="price"]');
  const categoryButtons = document.querySelectorAll('.filter-btn[data-filter-group="category"]');
  const cards = document.querySelectorAll('.product-card');

  let selectedPrice = 'all';
  let selectedCategory = 'all';

  function applyFilters() {
    cards.forEach((card) => {
      const priceMatch = selectedPrice === 'all' || card.getAttribute('data-price-range') === selectedPrice;
      const categoryMatch =
        selectedCategory === 'all' ||
        card.getAttribute(`data-${selectedCategory}`) === 'true';
      card.style.display = priceMatch && categoryMatch ? '' : 'none';
    });
  }

  priceButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      priceButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      selectedPrice = btn.getAttribute('data-value');
      applyFilters();
    });
  });

  categoryButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      categoryButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      selectedCategory = btn.getAttribute('data-value');
      applyFilters();
    });
  });

  document.querySelectorAll('.add-to-cart-btn').forEach((btn) => {
    const originalText = btn.textContent;
    btn.addEventListener('click', () => {
      if (!window.AuraCart) return;
      window.AuraCart.addItem({
        id: btn.getAttribute('data-id'),
        title: btn.getAttribute('data-title'),
        price: Number(btn.getAttribute('data-price')),
        cover: btn.getAttribute('data-cover'),
      });
      btn.textContent = '✓';
      setTimeout(() => {
        btn.textContent = originalText;
      }, 1000);
    });
  });

  // Lightbox
  const lightbox = document.getElementById('product-lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxCounter = document.getElementById('lightbox-counter');
  const lightboxPrev = document.getElementById('lightbox-prev');
  const lightboxNext = document.getElementById('lightbox-next');
  const lightboxClose = document.getElementById('lightbox-close');

  let currentImages = [];
  let currentIndex = 0;

  function updateLightboxImage() {
    lightboxImg.src = currentImages[currentIndex];
    const multi = currentImages.length > 1;
    lightboxCounter.textContent = multi ? `${currentIndex + 1} / ${currentImages.length}` : '';
    lightboxPrev.style.display = multi ? '' : 'none';
    lightboxNext.style.display = multi ? '' : 'none';
  }

  function openLightbox(images, startIndex) {
    currentImages = images;
    currentIndex = startIndex;
    updateLightboxImage();
    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
  }

  function closeLightbox() {
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
  }

  document.querySelectorAll('.product-img').forEach((img) => {
    img.addEventListener('click', () => {
      const images = img.getAttribute('data-images').split(',');
      openLightbox(images, 0);
    });
  });

  lightboxClose.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  lightboxPrev.addEventListener('click', () => {
    currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length;
    updateLightboxImage();
  });
  lightboxNext.addEventListener('click', () => {
    currentIndex = (currentIndex + 1) % currentImages.length;
    updateLightboxImage();
  });
  document.addEventListener('keydown', (e) => {
    if (!lightbox.classList.contains('is-open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') lightboxPrev.click();
    if (e.key === 'ArrowRight') lightboxNext.click();
  });
</script>